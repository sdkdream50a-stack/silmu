<%# 검토 보고서. 저장하지 않으므로 이 화면이 유일한 결과물이다 — 인쇄(PDF 저장)로 남긴다. %>
<% sev_class = { "BLOCK" => "bg-red-600 text-white", "WARN" => "bg-amber-400 text-slate-900", "CHECK" => "bg-sky-600 text-white", "PASS" => "bg-emerald-600 text-white" } %>
<% sev_label = { "BLOCK" => "확정 오류", "WARN" => "보완 필요", "CHECK" => "확인 필요", "PASS" => "통과" } %>
<% counts = @review.counts %>

<%= render "review_lab/hero", title: "#{@review.kind_label} 결과",
      lead: "규칙 검사 결과와 AI 검토 결과를 나눠 보여줍니다. 최종 판단은 담당자가 공식 근거로 확인합니다." %>

<div class="container-editorial py-8 space-y-8" id="review-report">
  <% if @demo %>
    <section class="rounded-xl border-2 border-dashed border-amber-400 bg-amber-50 p-5" aria-label="가상 예시 안내">
      <p class="text-sm font-bold text-amber-900">가상 예시 문서입니다 — 실제 학교·업체·사람이 아닙니다.</p>
      <p class="mt-1 text-sm text-amber-900">
        일부러 넣어 둔 오류 <strong><%= @demo[:expected].size %>건</strong> 중 <strong><%= @demo[:matched] %>건</strong>을 검사기가 같은 판정으로 찾았습니다.
        <% if @demo[:ok] %>빠진 것도, 더 나온 것도 없습니다.<% else %>차이가 있습니다(아래 표).<% end %>
      </p>
      <details class="mt-3">
        <summary class="cursor-pointer text-sm font-semibold text-amber-900">심어 둔 오류와 기대 판정 보기</summary>
        <table class="mt-2 w-full text-xs">
          <thead><tr class="text-left text-slate-600"><th class="py-1 pr-2">검사</th><th class="py-1 pr-2">기대 판정</th><th class="py-1">심어 둔 내용</th></tr></thead>
          <tbody>
            <% @demo[:expected].each do |code, sev, what| %>
              <tr class="border-t border-amber-200"><td class="py-1 pr-2 font-mono"><%= code %></td><td class="py-1 pr-2"><%= sev_label[sev] %></td><td class="py-1"><%= what %></td></tr>
            <% end %>
          </tbody>
        </table>
        <% unless @demo[:ok] %>
          <p class="mt-2 text-xs text-red-700">못 찾음: <%= @demo[:missing].map { |c, s| "#{c}(#{s})" }.join(", ").presence || "없음" %> · 더 나옴: <%= @demo[:extra].map { |c, s| "#{c}(#{s})" }.join(", ").presence || "없음" %></p>
        <% end %>
      </details>
    </section>
  <% end %>

  <section aria-label="요약" class="card-editorial">
    <p class="text-lg font-bold text-editorial-ink"><%= @review.headline %></p>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm">
      <% ReviewLab::Finding::SEVERITIES.each do |s| %>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1">
          <span class="inline-block rounded px-1.5 py-0.5 text-xs font-bold <%= sev_class[s] %>"><%= sev_label[s] %></span>
          <strong><%= counts[s] %></strong>
        </li>
      <% end %>
    </ul>
    <p class="mt-3 text-xs text-slate-500">실행한 규칙 묶음 <%= @review.rules_run %>개 · 규칙 검사 <%= @review.rule_findings.size %>건 · AI 검토 <%= @review.ai_findings.size %>건</p>
    <% if @ai_note %><p class="mt-2 text-xs text-sky-800"><%= @ai_note %></p><% end %>
  </section>

  <section aria-label="올린 문서">
    <h2 class="heading-editorial-section mb-3">올린 문서</h2>
    <ul class="space-y-2">
      <% @review.documents.each do |d| %>
        <li class="rounded-lg border <%= d.ok? ? 'border-slate-200' : 'border-red-300 bg-red-50' %> px-4 py-3 text-sm">
          <strong><%= d.label %></strong> <span class="text-slate-500">(<%= d.role_label %> · <%= d.format_label %>)</span>
          <% if d.ok? %>
            <span class="text-emerald-700">— <%= d.segments.size %>개 줄·행을 읽었습니다</span>
          <% else %>
            <p class="mt-1 text-red-800">읽지 못했습니다 — <%= d.error %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <% contract = @review.extras[:contract] %>
  <% if contract %>
    <% decision = contract[:result][:decision] || {} %>
    <section aria-label="계약방식 판정 연결" class="card-editorial">
      <h2 class="text-lg font-bold text-editorial-ink mb-2">계약방식·견적 요건 (기존 판정기 연결)</h2>
      <p class="text-xs text-slate-500 mb-3">공급가액 <%= contract[:assumed_estimated_price].to_i.to_fs(:delimited) %>원을 추정가격으로 <strong>가정</strong>한 참고 판정입니다.<%= " 값은 AI가 읽은 것이라 원본 대조 전까지 확정하지 않습니다." if contract[:from_ai] %></p>
      <% if contract[:result][:success] %>
        <p class="font-semibold text-editorial-ink"><%= decision[:headline] %></p>
        <% if (q = decision[:quotation]) %><p class="mt-1 text-sm text-slate-700">견적 요건: <%= q[:label] %></p><% end %>
        <% Array(decision[:unresolved_factors]).each do |u| %>
          <p class="mt-1 text-sm text-amber-800">아직 확인되지 않은 것: <%= u.is_a?(Hash) ? (u[:label] || u[:question] || u.values.first) : u %></p>
        <% end %>
        <ul class="mt-2 text-xs text-slate-600 space-y-1">
          <% Array(decision[:legal_basis]).each do |c| %>
            <li>근거: <%= link_to "#{c[:short]} #{c[:locator]}", c[:url], target: "_blank", rel: "noopener", class: "underline" %><% if c[:verified_at] %> (확인 <%= c[:verified_at] %>)<% end %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-700"><%= contract[:result][:error] || "판정에 필요한 값이 부족합니다." %></p>
      <% end %>
      <div class="mt-4 flex flex-wrap gap-2 text-sm">
        <%= link_to "계약방식 도구에서 조건 바꿔 보기", "/tools/contract-method", class: "underline text-editorial-navy" %>
        <% tool_evidence_slots("contract-method").each do |slot| %>
          <span aria-hidden="true">·</span><%= link_to "#{slot[:label]}: #{slot[:title]}", slot[:path], class: "underline text-editorial-navy" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @review.comparisons.any? %>
    <section aria-label="문서 간 상호대조">
      <h2 class="heading-editorial-section mb-3">문서 간 상호대조</h2>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-600">
            <tr>
              <th class="px-3 py-2">항목</th>
              <% @review.readable_documents.each do |d| %><th class="px-3 py-2"><%= d.label %></th><% end %>
              <th class="px-3 py-2">판정</th>
            </tr>
          </thead>
          <tbody>
            <% @review.comparisons.each do |c| %>
              <tr class="border-t border-slate-100 align-top">
                <th scope="row" class="px-3 py-2 text-left font-semibold text-editorial-ink whitespace-nowrap"><%= c[:name] %></th>
                <% @review.readable_documents.each do |d| %>
                  <% f = c[:cells][d.label] %>
                  <td class="px-3 py-2"><% if f %><%= f.raw %><br><span class="text-[11px] text-slate-400"><%= f.locator %></span><% else %><span class="text-slate-300">—</span><% end %></td>
                <% end %>
                <td class="px-3 py-2 whitespace-nowrap font-semibold <%= { '충돌' => 'text-red-700', '일치' => 'text-emerald-700', '형식 다름' => 'text-sky-700' }[c[:verdict]] || 'text-slate-500' %>"><%= c[:verdict] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-slate-500">«단일» = 한 문서에만 있음 · «원문 대조» = 서술형이라 기계로 같다/다르다를 판정하지 않음 · «—» = 그 문서에서 찾지 못함(없다는 뜻이 아닐 수 있음)</p>
    </section>
  <% end %>

  <% [ [ "규칙 검사 결과", @review.rule_findings, "코드가 문서 값으로 계산·대조한 결과입니다." ],
       [ "AI 검토 · 추가 확인 필요", @review.ai_findings, "AI 해석입니다. 법령 사실이나 확정 오류가 아니며, 모두 «확인 필요» 로만 표시합니다." ] ].each do |title, list, sub| %>
    <% next if list.empty? && title.start_with?("AI") %>
    <section aria-label="<%= title %>">
      <h2 class="heading-editorial-section mb-1"><%= title %></h2>
      <p class="text-xs text-slate-500 mb-3"><%= sub %></p>
      <% if list.empty? %>
        <p class="text-sm text-slate-600">결과 없음</p>
      <% end %>
      <ul class="space-y-3">
        <% @review.sorted_findings(list).each do |f| %>
          <li class="rounded-lg border <%= f.ai? ? 'border-sky-200 bg-sky-50/40' : 'border-slate-200 bg-white' %> p-4" data-severity="<%= f.severity %>" data-code="<%= f.code %>" data-origin="<%= f.origin %>">
            <p class="flex flex-wrap items-center gap-2">
              <span class="inline-block rounded px-1.5 py-0.5 text-xs font-bold <%= sev_class[f.severity] %>"><%= sev_label[f.severity] %></span>
              <span class="text-[11px] font-mono text-slate-400"><%= f.code %></span>
              <span class="text-[11px] rounded border <%= f.ai? ? 'border-sky-300 text-sky-800' : 'border-slate-300 text-slate-600' %> px-1.5"><%= f.origin_label %></span>
            </p>
            <p class="mt-1.5 font-semibold text-editorial-ink"><%= f.problem %></p>
            <dl class="mt-2 grid gap-x-3 gap-y-1 text-sm text-slate-700 sm:grid-cols-[7rem_1fr]">
              <% if f.extracted_value.present? %><dt class="text-slate-500">읽은 값</dt><dd><%= f.extracted_value %></dd><% end %>
              <% if f.source_document.present? || f.location.present? %><dt class="text-slate-500">위치</dt><dd><%= [ f.source_document, f.location ].compact_blank.join(" · ") %></dd><% end %>
              <% if f.why_it_matters.present? %><dt class="text-slate-500">왜 중요한가</dt><dd><%= f.why_it_matters %></dd><% end %>
              <% if f.evidence.any? %>
                <dt class="text-slate-500">근거</dt>
                <dd>
                  <% f.evidence.each do |e| %>
                    <% if e.is_a?(Hash) %>
                      <span class="block"><% if e[:url] %><%= link_to [ e[:short] || e[:title], e[:locator] ].compact.join(" "), e[:url], target: "_blank", rel: "noopener", class: "underline" %><% else %><%= [ e[:short] || e[:title], e[:locator] ].compact.join(" ") %> <span class="text-xs text-slate-400">(원문 링크 미확정)</span><% end %><% if e[:quote].present? %> — «<%= e[:quote] %>»<% end %></span>
                    <% else %>
                      <span class="block"><%= e %></span>
                    <% end %>
                  <% end %>
                </dd>
              <% end %>
              <% if f.suggested_action.present? %><dt class="text-slate-500">할 일</dt><dd><%= f.suggested_action %></dd><% end %>
              <% unless f.pass? %><dt class="text-slate-500">확신도</dt><dd><%= f.confidence %></dd><% end %>
            </dl>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if (pe = @review.extras[:price_evidence]) && pe[:rows].any? %>
    <section aria-label="가격 근거">
      <h2 class="heading-editorial-section mb-1">가격 근거 (적정성 판정 아님)</h2>
      <p class="text-xs text-slate-500 mb-3"><%= pe[:label] %> · 같은 품명·규격끼리만 나란히 놓습니다. 가격이 비싼지·싼지는 판정하지 않습니다.</p>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-600"><tr><th class="px-3 py-2">품명</th><th class="px-3 py-2">규격</th><th class="px-3 py-2">이 견적 단가</th><th class="px-3 py-2">같은 규격 비교견적</th></tr></thead>
          <tbody>
            <% pe[:rows].each do |r| %>
              <tr class="border-t border-slate-100 align-top">
                <td class="px-3 py-2"><%= r[:name] %></td>
                <td class="px-3 py-2"><%= r[:spec].presence || content_tag(:span, "규격 없음 — 비교 불가", class: "text-amber-800") %></td>
                <td class="px-3 py-2 whitespace-nowrap"><%= r[:unit_price] ? "#{r[:unit_price].to_i.to_fs(:delimited)}원" : "—" %></td>
                <td class="px-3 py-2">
                  <% if r[:others].any? %>
                    <% r[:others].each do |o| %><span class="block"><%= o[:document] %>: <%= o[:unit_price].to_i.to_fs(:delimited) %>원<% if o[:diff_pct] %> (<%= o[:diff_pct].positive? ? "+" : "" %><%= o[:diff_pct] %>%)<% end %></span><% end %>
                  <% else %><span class="text-slate-400">없음</span><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @review.skipped_rules.any? || @review.inconclusive? %>
    <section aria-label="검사하지 못한 항목" class="rounded-xl border border-slate-300 bg-slate-50 p-5">
      <h2 class="font-semibold text-editorial-ink mb-2">검사하지 못한 항목</h2>
      <p class="text-xs text-slate-600 mb-2">아래는 «문제 없음» 이 아니라 «확인하지 못함» 입니다.</p>
      <ul class="text-sm text-slate-700 space-y-1 list-disc pl-5">
        <% if @review.inconclusive? %><li>읽을 수 있는 문서나 검사할 값이 없어 규칙 검사를 하지 못했습니다.</li><% end %>
        <% @review.skipped_rules.uniq.each do |s| %><li><span class="font-mono text-xs text-slate-400"><%= s[:code] %></span> <%= s[:reason] %></li><% end %>
      </ul>
    </section>
  <% end %>

  <div class="flex flex-wrap gap-3 print:hidden">
    <button type="button" onclick="window.print()" class="rounded-lg bg-editorial-navy px-4 py-2 text-sm font-semibold text-white">인쇄 · PDF로 저장</button>
    <%= link_to "다른 문서 검토", @review.kind == :quote ? review_lab_quote_path : review_lab_package_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-editorial-ink" %>
    <%= link_to "검증실 처음으로", review_lab_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-editorial-ink" %>
  </div>

  <%= render "review_lab/notice" %>
</div>
