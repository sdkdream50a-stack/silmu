<%= render "review_lab/hero", title: "입찰공고 패키지 검토",
      lead: "공고문·과업지시서·규격서를 한 묶음으로 보고, 같은 항목이 문서마다 다르게 적힌 곳을 찾습니다. 공고기간은 지방계약법 시행령 §35 원문 기준으로 계산합니다." %>

<div class="container-editorial py-10 space-y-8 max-w-3xl">
  <%= render "review_lab/notice" %>

  <% if user_signed_in? %>
    <%= form_with url: review_lab_package_path, method: :post, multipart: true, data: { turbo: false }, class: "card-editorial space-y-5" do |f| %>
      <%# 2026-09-27 — 사용자가 «파일을 어디로 올리나» 를 물었다. 파일 칸이 버튼처럼 보이지 않았고 순서도 적혀 있지 않았다. %>
      <p class="rounded-lg bg-editorial-navy-bg px-4 py-3 text-sm text-editorial-ink">
        <strong>올리는 방법</strong> — ① 아래 칸의 <strong>«파일 선택»</strong> 버튼을 눌러 파일을 고르고 ② 맨 아래 <strong>«검토하기»</strong>를 누르세요.
        <span class="block mt-1 text-xs text-slate-600">파일당 최대 <%= ReviewLab::TextExtractor::MAX_BYTES / 1.megabyte %>MB · 합계 <%= ReviewLabController::MAX_TOTAL_BYTES / 1.megabyte %>MB · HWP는 HWPX나 PDF로 저장해 올려 주세요</span>
      </p>
      <p class="text-sm text-slate-600">문서를 <strong>2개 이상</strong> 올려 주세요. 역할을 맞게 넣어야 «공고문 필수 항목» 검사가 정확합니다.</p>
      <% ReviewLabController::PACKAGE_ROLES.each do |role| %>
        <div>
          <%= f.label "files_#{role}", ReviewLab::DocumentArtifact::ROLES.fetch(role), class: "block text-sm font-semibold text-editorial-ink mb-1" %>
          <%= f.file_field "files[#{role}]", id: "files_#{role}", accept: ".hwpx,.docx,.xlsx,.pdf", class: "block w-full text-sm text-slate-700 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-3 cursor-pointer file:mr-3 file:rounded-lg file:border-0 file:bg-editorial-navy file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white file:cursor-pointer hover:file:opacity-90" %>
        </div>
      <% end %>
      <div>
        <%= f.label "files_other", "기타 첨부 (최대 #{ReviewLabController::MAX_OTHER_FILES}개)", class: "block text-sm font-semibold text-editorial-ink mb-1" %>
        <%= f.file_field "files[other]", id: "files_other", multiple: true, accept: ".hwpx,.docx,.xlsx,.pdf", class: "block w-full text-sm text-slate-700 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-3 cursor-pointer file:mr-3 file:rounded-lg file:border-0 file:bg-editorial-navy file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white file:cursor-pointer hover:file:opacity-90" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :contract_type, "계약 유형", class: "block text-sm font-semibold text-editorial-ink mb-1.5" %>
          <%= f.select :contract_type, contract_type_options, { include_blank: "선택 안 함" }, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
        <div>
          <%= f.label :agency_scope, "기관", class: "block text-sm font-semibold text-editorial-ink mb-1.5" %>
          <%= f.select :agency_scope, agency_scope_options, { include_blank: "선택 안 함" }, class: "w-full rounded-md border-slate-300 text-sm" %>
        </div>
      </div>
      <p class="text-xs text-slate-500">공사를 고르면 추정가격 구간별 공고기간(§35③)을, 협상에 의한 계약이 적혀 있으면 §35⑤ 기간을 씁니다. 사립학교·국가기관은 다른 법령이라 공고기간을 «확인 필요» 로 둡니다.</p>
      <div class="rounded-lg border border-slate-200 p-4 space-y-3">
        <label class="flex items-start gap-2 text-sm text-slate-800">
          <%= f.check_box :use_ai, { class: "mt-0.5" }, "1", "0" %>
          <span><strong>AI 의미검사 추가</strong> — 모호한 표현·문서 간 의미 충돌·과업범위 누락 의심을 찾습니다. 결과는 모두 «추가 확인 필요» 로만 표시합니다.</span>
        </label>
        <%= render "shared/ai_privacy_notice", what: "선택 시 문서 본문(개인정보 형태는 자동으로 가린 뒤)", scope: :file %>
      </div>
      <%= f.submit "검토하기", class: "rounded-lg bg-editorial-navy px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90 cursor-pointer" %>
    <% end %>
  <% else %>
    <%= render "review_lab/login_gate" %>
  <% end %>

  <%= render "review_lab/formats" %>
</div>
