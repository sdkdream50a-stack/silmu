<% legal_basis = topic_legal_basis(@topic).filter_map do |basis|
     name = basis["name"].presence || basis[:name].to_s
     url = basis["url"].presence || basis[:url].to_s
     { name: name, url: url } if name.present? && url.present?
   end %>
<% if legal_basis.present? %>
  <section class="bg-white border-b border-slate-100" aria-label="근거 법령">
    <div class="container-wide py-4">
      <div class="rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-emerald-50/40 p-4 shadow-soft">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="flex items-center gap-2.5 shrink-0">
            <div class="icon-container icon-container-sm bg-indigo-100">
              <span class="material-symbols-outlined text-indigo-600">gavel</span>
            </div>
            <p class="text-sm font-bold text-slate-900">근거 법령</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <% legal_basis.each do |basis| %>
              <%= link_to basis[:url],
                  target: "_blank",
                  rel: "noopener noreferrer nofollow",
                  class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-white px-3 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm transition-colors hover:bg-indigo-50 hover:text-indigo-900" do %>
                <span class="material-symbols-outlined text-sm">open_in_new</span>
                <span><%= basis[:name] %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>
