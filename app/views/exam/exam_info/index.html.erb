<%# exam.silmu.kr/exam-info — 공공조달관리사 시험 정보 페이지 — Stitch 'The Authoritative Ledger' 디자인 적용 %>

<% content_for :head do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "@id": "https://exam.silmu.kr/exam-info#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "공공조달관리사 시험은 언제 시행되나요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "2026년 제1회 시험이 큐넷(Q-Net)에 공고되었습니다. 필기 원서접수 2026년 9월 14일~17일, 필기시험 10월 3일, 필기 합격발표 10월 12일, 실기시험 11월 14일, 최종 합격발표 12월 18일입니다."
          }
        },
        {
          "@type": "Question",
          "name": "공공조달관리사 응시자격은 무엇인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "별도 응시 제한 없이 누구나 응시 가능합니다. 학력·경력 제한이 없는 국가기술자격입니다."
          }
        },
        {
          "@type": "Question",
          "name": "공공조달관리사 시험 과목은 무엇인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "필기시험은 3과목 80문항(4지 택일)으로 구성됩니다. 공공조달과 법제도 이해 30문항, 공공조달계획 수립 및 분석 20문항, 공공계약관리 30문항입니다. 실기시험은 공공조달 관리실무 필답형입니다."
          }
        },
        {
          "@type": "Question",
          "name": "공공조달관리사 합격 기준은 무엇인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "필기시험은 100점 만점 기준 매 과목 40점 이상, 전 과목 평균 60점 이상이면 합격입니다. 실기시험은 100점 만점 기준 60점 이상이면 합격이며, 필기시험 합격자만 실기시험에 응시할 수 있습니다."
          }
        },
        {
          "@type": "Question",
          "name": "공공조달관리사 자격증 활용 분야는 어디인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "공공기관, 지방자치단체, 공기업 등의 조달·계약 부서, 민간기업의 입찰·조달 업무, 조달 컨설팅 분야에서 활용 가능합니다."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "공공조달관리사 시험 대비",
          "item": "https://exam.silmu.kr"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "시험 정보",
          "item": "https://exam.silmu.kr/exam-info"
        }
      ]
    }
  ]
}
</script>
<% end %>

<!-- 히어로 — Stitch navy gradient -->
<section class="bg-gradient-to-br from-[#465f88] to-[#3a537c] text-white py-14 px-4 relative overflow-hidden">
  <!-- 배경 장식 -->
  <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -mr-36 -mt-36 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full -ml-24 -mb-24 pointer-events-none"></div>
  <div class="max-w-4xl mx-auto relative z-10">
    <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
      <span class="material-symbols-outlined text-[#ffd166] text-base">verified</span>
      국가기술자격 — 2026년 제1회 시행
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-snug mb-4 tracking-tight text-[#f6f7ff]">
      공공조달관리사<br>시험 정보 완벽 정리
    </h1>
    <p class="text-[#c8d6f5] text-lg mb-6 max-w-2xl">
      응시자격·시험 일정·과목 구성·합격기준·접수 방법까지.<br>
      <%= ExamSchedule::SOURCE_NAME %> 기준 정보를 확인하세요.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="#schedule" class="inline-flex items-center gap-1.5 bg-white text-[#465f88] font-bold px-5 py-2.5 rounded-full hover:bg-[#f6f7ff] transition-colors text-sm shadow-lg">
        <span class="material-symbols-outlined text-base">calendar_month</span>
        시험 일정
      </a>
      <a href="#subjects" class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm border border-white/30 text-white font-semibold px-5 py-2.5 rounded-full hover:bg-white/25 transition-colors text-sm">
        <span class="material-symbols-outlined text-base">quiz</span>
        시험 과목
      </a>
      <a href="#qualification" class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm border border-white/30 text-white font-semibold px-5 py-2.5 rounded-full hover:bg-white/25 transition-colors text-sm">
        <span class="material-symbols-outlined text-base">person_check</span>
        응시자격
      </a>
    </div>
  </div>
</section>

<!-- 표준교재 PDF 다운로드 배너 -->
<div class="bg-[#f0f4f7] border-b border-[#c8d6e0] px-4 py-3">
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="material-symbols-outlined text-[#465f88] text-xl flex-shrink-0">menu_book</span>
      <span class="text-[#2c3e55] text-sm font-semibold">표준교재 4권 무료 PDF — 조달청 발간(2026.01.16 공개)</span>
    </div>
    <a href="https://eiec.kdi.re.kr/policy/materialView.do?num=276002"
       target="_blank" rel="noopener"
       class="inline-flex items-center gap-1.5 bg-[#465f88] hover:bg-[#3a537c] text-white font-bold px-4 py-2 rounded-full text-xs transition-colors whitespace-nowrap flex-shrink-0">
      <span class="material-symbols-outlined text-sm">download</span>
      무료 다운로드
    </a>
  </div>
</div>

<!-- 안내 바 -->
<div class="bg-amber-50 border-b border-amber-200 px-4 py-3">
  <div class="max-w-4xl mx-auto flex items-start gap-2 text-sm text-amber-800">
    <span class="material-symbols-outlined text-amber-500 text-base flex-shrink-0 mt-0.5">info</span>
    <span>제1회 시험 일정은 <a href="<%= ExamSchedule::SOURCE_URL %>" target="_blank" rel="noopener" class="underline font-semibold">큐넷(Q-Net) 공고</a> 기준입니다(<%= ExamSchedule::VERIFIED_ON.strftime("%Y.%m.%d") %> 확인). 접수·변경 사항은 반드시 큐넷 공식 공고로 최종 확인하세요.</span>
  </div>
</div>

<div class="py-12 px-4 bg-[#f7f9fb]">
  <div class="max-w-4xl mx-auto space-y-14">

    <!-- 1. 자격 개요 -->
    <section>
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-6 flex items-center gap-3">
        <span class="w-8 h-8 bg-[#465f88] text-white rounded-lg flex items-center justify-center text-sm font-bold flex-shrink-0">01</span>
        자격 개요
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <dl class="bg-white rounded-2xl shadow-[0_12px_40px_rgba(42,52,57,0.06)] p-6 space-y-4">
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">자격명</dt>
            <dd class="font-semibold text-slate-800 text-right">공공조달관리사</dd>
          </div>
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">자격 종류</dt>
            <dd class="font-semibold text-slate-800">국가기술자격</dd>
          </div>
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">관련 부처</dt>
            <dd class="font-semibold text-slate-800 text-right">조달청(재정경제부 외청)</dd>
          </div>
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">시행 기관</dt>
            <dd class="font-semibold text-slate-800 text-right">한국산업인력공단 (Q-NET)</dd>
          </div>
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">시행 근거</dt>
            <dd class="font-semibold text-slate-800 text-right text-sm">국가기술자격법</dd>
          </div>
          <div class="flex justify-between items-start border-b border-[#f0f4f7] pb-3">
            <dt class="text-slate-500 text-sm">필기 방식</dt>
            <dd class="font-semibold text-slate-800">CBT (컴퓨터 기반)</dd>
          </div>
          <div class="flex justify-between items-start">
            <dt class="text-slate-500 text-sm">실기 방식</dt>
            <dd class="font-semibold text-slate-800">필답형</dd>
          </div>
        </dl>
        <div class="bg-white rounded-2xl shadow-[0_12px_40px_rgba(42,52,57,0.06)] p-6">
          <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2 text-base">
            <span class="material-symbols-outlined text-[#465f88] text-lg">lightbulb</span>
            왜 주목받는 자격증인가?
          </h3>
          <ul class="space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-3 border-l-4 border-[#465f88] pl-3 py-1">
              <div>
                <span class="font-semibold text-slate-900">최초 국가기술자격</span>
                <p class="text-slate-500 text-xs mt-0.5">공공조달 분야 공식 역량 인증</p>
              </div>
            </li>
            <li class="flex items-start gap-3 border-l-4 border-[#465f88]/40 pl-3 py-1">
              <div>
                <span class="font-semibold text-slate-900">연간 200조원 시장</span>
                <p class="text-slate-500 text-xs mt-0.5">공공조달 분야 전문 자격</p>
              </div>
            </li>
            <li class="flex items-start gap-3 border-l-4 border-[#465f88]/40 pl-3 py-1">
              <div>
                <span class="font-semibold text-slate-900">법령상 우대 현황 없음</span>
                <p class="text-slate-500 text-xs mt-0.5">큐넷 우대현황 기준 · 공무원 가산점 대상 아님</p>
              </div>
            </li>
            <li class="flex items-start gap-3 border-l-4 border-[#465f88]/40 pl-3 py-1">
              <div>
                <span class="font-semibold text-slate-900">민간기업 필수 스펙</span>
                <p class="text-slate-500 text-xs mt-0.5">공공입찰 담당자 역량 인증으로 부상</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 2. 응시 자격 -->
    <section id="qualification">
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-6 flex items-center gap-3">
        <span class="w-8 h-8 bg-[#465f88] text-white rounded-lg flex items-center justify-center text-sm font-bold flex-shrink-0">02</span>
        응시 자격
      </h2>
      <div class="bg-white rounded-2xl shadow-[0_12px_40px_rgba(42,52,57,0.06)] overflow-hidden">
        <div class="p-6">
          <p class="text-slate-600 text-sm mb-5">
            공공조달관리사는 별도 응시 제한 없이 <strong>누구나 응시 가능</strong>합니다.
            다만 실기 시험의 경우 실무 경력이 도움이 됩니다.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-[#f0f4f7] rounded-xl p-5 text-center">
              <div class="w-12 h-12 bg-[#e1e9ee] rounded-xl flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-[#465f88] text-2xl">person</span>
              </div>
              <h3 class="font-bold text-slate-800 mb-1">학력 제한</h3>
              <p class="text-slate-500 text-sm">없음<br>학력 무관 응시 가능</p>
            </div>
            <div class="bg-[#f0f4f7] rounded-xl p-5 text-center">
              <div class="w-12 h-12 bg-[#e1e9ee] rounded-xl flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-[#465f88] text-2xl">work</span>
              </div>
              <h3 class="font-bold text-slate-800 mb-1">경력 제한</h3>
              <p class="text-slate-500 text-sm">없음<br>신입·비전공자도 응시</p>
            </div>
            <div class="bg-[#f0f4f7] rounded-xl p-5 text-center">
              <div class="w-12 h-12 bg-[#e1e9ee] rounded-xl flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-[#465f88] text-2xl">groups</span>
              </div>
              <h3 class="font-bold text-slate-800 mb-1">응시 대상</h3>
              <p class="text-slate-500 text-sm">공무원·민간인·취업준비생<br>누구나 응시 가능</p>
            </div>
          </div>
        </div>
        <div class="bg-[#465f88] text-white px-6 py-4">
          <p class="text-sm flex items-center gap-2 text-white">
            <span class="material-symbols-outlined text-[#ffd166] text-base">star</span>
            <strong>추천 응시자:</strong> 공공기관·지방자치단체 계약 담당 공무원, 나라장터 입찰 참여 민간기업 담당자, 공공조달 분야 취업 희망자
          </p>
        </div>
      </div>
    </section>

    <!-- 3. 시험 일정 -->
    <section id="schedule">
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-6 flex items-center gap-3">
        <span class="w-8 h-8 bg-[#465f88] text-white rounded-lg flex items-center justify-center text-sm font-bold flex-shrink-0">03</span>
        시험 일정 <span class="text-sm font-normal text-slate-400 ml-1">(2026년 제1회)</span>
        <%= content_badge(:official) %>
      </h2>
      <div class="relative">
        <!-- 타임라인 선 -->
        <div class="absolute left-[1.75rem] top-8 bottom-8 w-0.5 bg-[#c8d6e0] hidden sm:block"></div>
        <div class="space-y-4">
          <% ExamSchedule::TIMELINE.each_with_index do |item, idx| %>
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#e1e9ee] rounded-xl flex items-center justify-center flex-shrink-0 border-4 border-[#f7f9fb] shadow-sm relative z-10">
                <span class="material-symbols-outlined text-[#465f88] text-xl"><%= item[:icon] %></span>
              </div>
              <div class="flex-1 bg-white rounded-xl shadow-[0_4px_16px_rgba(42,52,57,0.05)] p-4">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="font-bold text-slate-900"><%= item[:step] %></h3>
                  <span class="text-xs bg-[#eef2f7] text-[#465f88] font-semibold px-2 py-0.5 rounded-full"><%= item[:period] %></span>
                </div>
                <p class="text-slate-500 text-sm"><%= item[:detail] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 flex items-start gap-2">
        <span class="material-symbols-outlined text-amber-500 text-base flex-shrink-0 mt-0.5">warning</span>
        <p class="text-amber-800 text-sm">위 일정은 <a href="<%= ExamSchedule::SOURCE_URL %>" target="_blank" rel="noopener" class="underline font-semibold">큐넷(Q-Net) 공고</a> 기준입니다(<%= ExamSchedule::VERIFIED_ON.strftime("%Y.%m.%d") %> 확인). 시간·장소 등 세부 사항은 큐넷에서 최종 확인하세요.</p>
      </div>
      <div class="mt-3 bg-[#eef2f7] rounded-xl px-4 py-3 flex items-start gap-2">
        <span class="material-symbols-outlined text-[#465f88] text-base flex-shrink-0 mt-0.5">info</span>
        <p class="text-[#2c3e55] text-sm"><strong class="text-[#465f88]">다음 회차</strong> — 제2회 이후 시험 일정은 아직 확인되지 않았습니다. 큐넷(Q-Net) 공고를 확인하세요.</p>
      </div>
    </section>

    <!-- 4. 시험 과목 -->
    <section id="subjects">
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight mb-6 flex items-center gap-3">
        <span class="w-8 h-8 bg-[#465f88] text-white rounded-lg flex items-center justify-center text-sm font-bold flex-shrink-0">04</span>
        시험 과목 및 배점
      </h2>

      <!-- 필기 -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="bg-[#465f88] text-white text-xs font-bold px-3 py-1 rounded-full">필기</span>
          <span class="text-slate-500 text-sm">객관식 3과목 · 총 80문항 · 시험 시간 120분 · <strong class="text-[#465f88]">CBT(컴퓨터 기반)</strong></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <% [
            {
              vol: "1", title: "공공조달과 법제도 이해",
              items: ["공공조달 개념·제도 체계", "국가계약법·지방계약법·조달사업법·전자조달법", "조달청 기능과 나라장터 시스템", "WTO GPA 및 국제 조달"],
              weight: "30문항"
            },
            {
              vol: "2", title: "공공조달계획 수립 및 분석",
              items: ["수요·공급 분석 및 조달 전략", "예산 편성과 예정가격 산정", "입찰 방식 선택 기준", "시장 분석 및 적정성 검토"],
              weight: "20문항"
            },
            {
              vol: "3", title: "공공계약관리",
              items: ["경쟁입찰 절차와 낙찰 방식", "수의계약 요건·계약 체결", "보증금·이행 관리·설계변경", "검사·대금지급·지체상금"],
              weight: "30문항"
            }
          ].each do |s| %>
            <div class="bg-white rounded-xl shadow-[0_12px_40px_rgba(42,52,57,0.06)] overflow-hidden hover:shadow-[0_16px_48px_rgba(42,52,57,0.1)] transition-shadow">
              <div class="bg-[#eef2f7] px-5 py-3 flex items-center justify-between border-b border-[#d9e4ea]">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 bg-[#465f88] text-white rounded-md flex items-center justify-center text-xs font-bold"><%= s[:vol] %></span>
                  <span class="font-bold text-slate-800 text-sm"><%= s[:title] %></span>
                </div>
