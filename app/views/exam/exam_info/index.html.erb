        </div>
        <div class="bg-white rounded-2xl shadow-[0_12px_40px_rgba(42,52,57,0.06)] p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-rose-100 rounded-xl flex items-center justify-center">
              <span class="material-symbols-outlined text-rose-600">assignment_turned_in</span>
            </div>
            <h3 class="font-bold text-slate-900">실기 합격 기준</h3>
          </div>
