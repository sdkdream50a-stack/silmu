<?xml version="1.0" encoding="UTF-8"?>
<%# lastmod 생략: 정적 커리큘럼 데이터라 실제 갱신일 없음. 사용자별·noindex 화면(/quiz/wrong·/quiz/analysis·/rankings)은 제외 %>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <%# 홈 %>
  <url>
    <loc>https://exam.silmu.kr/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <%# 커리큘럼 목록 %>
  <url>
    <loc>https://exam.silmu.kr/subjects</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

  <%# 과목별 페이지 + 챕터 페이지 %>
  <% @subjects.each do |subject| %>
  <url>
    <loc>https://exam.silmu.kr/subjects/<%= subject[:id] %></loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <% subject[:chapters].each do |chapter| %>
  <url>
    <loc>https://exam.silmu.kr/subjects/<%= subject[:id] %>/chapters/<%= chapter[:number] %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>
  <% end %>

  <%# 시험 정보 %>
  <url>
    <loc>https://exam.silmu.kr/exam-info</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <%# 핵심 용어집 %>
  <url>
    <loc>https://exam.silmu.kr/keywords</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <%# 모의고사 선택 %>
  <url>
    <loc>https://exam.silmu.kr/quiz</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

  <%# 과목별 모의고사 — quizzes#show가 실제로 서빙하는 시험 과목만(없는 과목은 302) %>
  <% @quiz_subjects.each do |subject| %>
  <url>
    <loc>https://exam.silmu.kr/quiz/<%= subject[:id] %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>

  <%# 전체 모의고사 %>
  <url>
    <loc>https://exam.silmu.kr/quiz/all</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <%# 실전 시험 모드 %>
  <url>
    <loc>https://exam.silmu.kr/quiz/simulation</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <%# 합격 전략 가이드 %>
  <url>
    <loc>https://exam.silmu.kr/exam-strategy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <%# 실기 대비 필답형 예상문제 %>
  <url>
    <loc>https://exam.silmu.kr/practical</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <%# 챕터별 문제 풀기 %>
  <% @subjects.each do |subject| %>
  <% subject[:chapters].each do |chapter| %>
  <url>
    <loc>https://exam.silmu.kr/quiz/subject/<%= subject[:id] %>/chapter/<%= chapter[:number] %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <% end %>
</urlset>
