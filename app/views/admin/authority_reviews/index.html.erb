<% content_for :title, "법령 현행성 검토 — Admin" %>

<div class="container-wide py-8">
  <h1 class="text-2xl font-bold text-slate-900 mb-1">법령 현행성 검토 큐</h1>
  <p class="text-sm text-slate-600 mb-6">
    Freshness Engine 이 감지한 법령 변경과 영향 가능 콘텐츠입니다.
    <strong>이 화면은 콘텐츠를 수정하지 않습니다</strong> — 판정만 기록합니다.
  </p>

  <%# 통계 %>
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-8">
    <% [["검토 대기", @stats[:open], "text-rose-600"],
        ["전체 태스크", @stats[:total], "text-slate-700"],
        ["열린 변경", @stats[:events_open], "text-amber-600"],
        ["최근 7일 검증", @stats[:verifications_7d], "text-emerald-600"],
        ["영향 간선", @stats[:link_count], "text-slate-700"]].each do |label, value, color| %>
      <div class="bg-white border border-slate-200 rounded-lg p-3 text-center">
        <p class="text-xs text-slate-500 m-0"><%= label %></p>
        <p class="text-2xl font-bold <%= color %> m-0"><%= value %></p>
      </div>
    <% end %>
  </div>

  <%# 감시 소스 · 문서 %>
  <section class="mb-8">
    <h2 class="text-lg font-bold text-slate-900 mb-3">감시 대상</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-xs border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="text-left px-3 py-2">문서</th>
            <th class="text-left px-3 py-2">유형</th>
            <th class="text-left px-3 py-2">현행 시행일</th>
            <th class="text-left px-3 py-2">버전</th>
            <th class="text-left px-3 py-2">영향 간선</th>
            <th class="text-left px-3 py-2">마지막 검사</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @documents.each do |doc| %>
            <% v = doc.current_version %>
            <tr>
              <td class="px-3 py-2 font-medium text-slate-900"><%= doc.display_title %></td>
              <td class="px-3 py-2 text-slate-600"><%= doc.document_type_label %></td>
              <td class="px-3 py-2 <%= v&.future_effective? ? "text-amber-700 font-semibold" : "text-slate-700" %>">
                <%= v ? v.effective_label : "미수집" %>
              </td>
              <td class="px-3 py-2 text-slate-600"><%= doc.authority_versions.count %></td>
              <td class="px-3 py-2 text-slate-600"><%= ContentAuthorityLink.where(authority_document_id: doc.id).count %></td>
              <td class="px-3 py-2 text-slate-500"><%= doc.last_checked_at&.strftime("%m-%d %H:%M") || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-500 mt-2">
      <% @sources.each do |s| %>
        <%= s.name %> · <%= s.tier_label %> · 주기 <%= s.check_interval_hours %>h ·
        마지막 성공 <%= s.last_success_at&.strftime("%Y-%m-%d %H:%M") || "없음" %>
        <% if s.failure_count.positive? %>
          · <span class="text-rose-600 font-semibold">연속실패 <%= s.failure_count %>(<%= s.last_failure_kind %>)</span>
        <% end %>
      <% end %>
    </p>
  </section>

  <%# 검토 큐 %>
  <section>
    <div class="flex items-center gap-3 mb-3">
      <h2 class="text-lg font-bold text-slate-900 m-0">검토 태스크</h2>
      <%= link_to "열림만", admin_authority_reviews_path(status: "open"),
            class: "text-xs px-2 py-1 rounded #{@status == 'open' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700'}" %>
      <%= link_to "전체", admin_authority_reviews_path(status: "all"),
            class: "text-xs px-2 py-1 rounded #{@status == 'all' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700'}" %>
    </div>

    <% if @tasks.empty? %>
      <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-6 text-center">
        <p class="text-sm text-emerald-800 m-0 font-semibold">검토 대기 중인 태스크가 없습니다.</p>
        <p class="text-xs text-emerald-700 mt-1 m-0">감지된 법령 변경이 없거나, 모두 판정 완료되었습니다.</p>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @tasks.each do |task| %>
          <% event = task.authority_change_event %>
          <% doc = event.authority_document %>
          <div class="bg-white border border-slate-200 rounded-lg p-4">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
              <div class="min-w-0">
                <p class="text-sm font-bold text-slate-900 m-0">
                  <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold
                    <%= { "DIRECT" => "bg-rose-100 text-rose-800", "INDIRECT" => "bg-amber-100 text-amber-800",
                          "POSSIBLE" => "bg-sky-100 text-sky-800", "UNKNOWN" => "bg-slate-200 text-slate-800",
                          "NO_IMPACT" => "bg-slate-100 text-slate-600" }[task.impact_class] %>">
                    P<%= task.priority %> <%= task.impact_class %>
                  </span>
                  <%= task.affected_label %>
                </p>
                <p class="text-xs text-slate-600 mt-1 m-0">
                  근거 <strong><%= doc.display_title %></strong> ·
                  변경 <%= event.change_type_label %> ·
                  시행일 <%= event.effective_at&.strftime("%Y.%m.%d") || "미상" %>
                  <% if event.effective_at.present? && event.effective_at > Date.current %>
                    <span class="text-amber-700 font-semibold">(시행 예정)</span>
                  <% end %>
                </p>
              </div>
              <span class="text-[11px] px-2 py-1 rounded bg-slate-100 text-slate-700 shrink-0"><%= task.status %></span>
            </div>

            <p class="text-xs text-slate-700 bg-slate-50 rounded p-2 m-0 mb-2"><%= task.impact_reason %></p>
            <% if event.diff_summary.present? %>
              <p class="text-[11px] text-slate-600 m-0 mb-3"><span class="font-semibold">diff:</span> <%= event.diff_summary %></p>
            <% end %>

            <% if task.open? %>
              <%= form_with url: decide_admin_authority_review_path(task), method: :post,
                            class: "flex flex-wrap items-center gap-2" do |f| %>
                <%= hidden_field_tag :status, @status %>
                <%= text_field_tag :note, nil, placeholder: "검토 메모 (선택)",
                      class: "text-xs border border-slate-300 rounded px-2 py-1 flex-1 min-w-[180px]" %>
                <% AuthorityReviewTask::DECISIONS.each do |decision| %>
                  <%= submit_tag decision, name: "decision",
                        class: "text-[11px] px-2 py-1 rounded border cursor-pointer #{decision == 'NO_IMPACT' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50'}" %>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-[11px] text-slate-500 m-0">
                <%= task.reviewed_at&.strftime("%Y-%m-%d %H:%M") %> · <%= task.assigned_to %>
                <%= " · #{task.review_note}" if task.review_note.present? %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
