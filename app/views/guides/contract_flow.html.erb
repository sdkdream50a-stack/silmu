  'service-3' => { title: '추정가격 산정', num: 3, items: ['원가계산 방식: 인건비, 경비, 이윤 등 항목별 산출', '시장조사 방식: 유사 용역 계약 사례 참고', '노임단가는 한국엔지니어링협회 등 공표 단가 적용', '추정가격 산출 (VAT 제외) — 금액 불문 필수'], tip: '기술용역 원가계산 시 엔지니어링사업대가기준을 참고하세요.', small: '소액 단순용역은 원가계산 대신 시장조사(견적서 비교)로 추정가격 산정이 가능합니다. 복잡한 원가계산은 기술용역에만 적용하세요.', laws: [{ ref: '지방계약법 시행령 제2조 제1호', desc: '추정가격의 정의', href: '/topics/estimated-amount' }, { ref: '지방계약법 시행령 제7조', desc: '추정가격의 산정', href: '/topics/estimated-amount' }, { ref: '행정안전부 예규 「지방자치단체 입찰 및 계약집행기준」', desc: '예정가격 작성(원가계산) 근거', href: '/topics/estimated-price' }, { ref: '엔지니어링산업 진흥법 및 「엔지니어링사업대가의 기준」(산업통상자원부 고시)', desc: '기술용역(엔지니어링) 대가 산정 근거' }], docs: ['(내)원가계산서[인건비·경비·이윤·노임단가] 또는 시장조사서', '(내)추정가격 산정내역(VAT 제외)'] },
  'service-4' => { title: '계약 체결', num: 4, items: ['입찰 또는 수의계약 방식 결정 (용역: 2,000만원 이하 수의계약)', '과업내용서(과업지시서)를 계약서 별첨으로 반드시 포함', '지식재산권 귀속 조항 확인', '계약이행보증서, 인감증명서 등 서류 징구'], tip: '기술용역은 가격만이 아닌 기술력 평가가 중요합니다. 협상에 의한 계약 검토도 고려하세요.', small: '2,000만원 이하 수의계약 가능. 5,000만원 이하 계약서 생략 가능 (시행령 제50조). 계약이행보증서도 면제 가능합니다.', docs: ['(내/외)계약서(또는 전자계약서)[과업내용서 별첨·지재권 귀속]', '(외)계약이행보증서, (내)면제 사유 검토·결정[용역 추정가격 5천만원 이하 면제 가능]', '(외)사업자등록증·인감증명서·청렴서약서·통장사본', '(내)부정당업자 조회'] },
  'service-5' => { title: '착수', num: 5, items: ['착수계 제출 접수 (착수일로부터 용역기간 기산)', '투입인력 명단 확인 (계약서 명시 인력과 일치 여부)', '세부 추진계획서 검토', '킥오프 미팅 개최 (과업 내용 상호 확인)'], tip: '착수 시 과업 범위를 양측이 명확히 합의해두면 이후 분쟁을 줄일 수 있습니다.', small: '소액 단기용역은 착수계·추진계획서를 간소화할 수 있습니다. 이메일이나 유선으로 착수일 확인 후 기록을 남겨두면 됩니다.', docs: ['(외)착수계', '(외)투입인력 명단·자격증빙[계약명시 일치]', '(내)킥오프 회의록'] },
  'service-6' => { title: '이행/감독', num: 6, items: ['계약서에 명시된 보고 주기 준수 여부 점검', '투입인력 실제 근무 여부 확인', '중간 진행상황 점검 회의 개최', '무단 하도급 여부 점검'], tip: '정기적인 중간점검을 통해 문제를 조기에 발견하면 준공 시 보완 부담을 줄일 수 있습니다.', small: '단기 소액용역은 별도 중간보고 없이 수시 확인으로 갈음 가능. 다만 진행 경과를 메모나 이메일로 남겨두는 것이 좋습니다.', docs: ['(외)중간보고서', '(내)감독·점검일지·근무확인'] },
  'service-7' => { title: '준공/검수', num: 7, items: ['준공계 제출 접수 (준공기한 내 제출 확인)', '과업내용서 기준 성과품 검수 (항목별 대조)', '필요시 전문가 검수 의뢰', '성과품 인수 및 보관'], tip: '준공 전 사전검토를 통해 보완 기회를 부여하면 최종 성과품 품질이 높아집니다.', small: '소액도 검수조서 작성은 필수. 전문가 검수 의뢰는 기술용역에 한하며, 단순용역은 담당자 자체검수로 충분합니다.', docs: ['(외)준공계', '(외)성과품', '(내)완료(준공)검사조서[추정가격 3천만원 초과 필수; 기술용역=전문가 검수]'] },
  'service-8' => { title: '대금 지급', num: 8, items: ['세금계산서 발행 확인', '지출결의서 작성 및 결재', '대가 지급 청구를 받은 날부터 5일 이내 대금 지급 (지방계약법 제18조·시행령 제67조)', '선금 지급 시 선금급 지급비율 확인 (70% 이내)'], tip: '기성금 청구 시에는 기성검사가 선행되어야 합니다. 검사 없이 지급하면 감사 지적 대상입니다.', small: '소액 단기용역은 기성금 분할 없이 완료 후 일시불 지급이 일반적. 선금 지급도 소액에서는 거의 없습니다.', docs: ['(외)세금계산서', '(외)대금 지급청구서', '(내)지출결의서[청구받은 날부터 5일 이내; 기성=기성검사 선행]'], final_docs: service_final_docs },
  'construction-1' => { title: '기본계획', num: 1, items: ['공사 목적, 범위, 공법 결정', '사업비(예산) 확보 확인', '인허가 사항 사전 검토 (건축허가, 도로점용 등)', '부지 확보 및 지장물 조사'], tip: '인허가와 부지 확보가 지연되면 전체 일정에 영향을 미칩니다. 가장 먼저 확인하세요.', small: '소규모 시설물 보수·수선은 별도 인허가 불요. 기존 시설 현황 사진 촬영만으로 충분합니다.', docs: ['(내)공사추진 품의서', '(내)예산확보 확인', '(내)부지·지장물 조사서·현황사진'] },
  'construction-2' => { title: '설계', num: 2, items: ['계약방식에 따라 설계서 구성 달라짐: 수의계약은 간소화, 경쟁입찰은 상세화', '수의계약용: 시방서 + 품목 리스트 (간접비 계산 생략)', '경쟁입찰용: 물량내역서 (간접비 포함) + 시방서 + 현장설명서', '내역서 단가 적정성 검증 (표준품셈, 실적공사비)'], tip: '수의계약은 업체가 자체 간접비를 산정하므로 발주청은 품목별 직접비만 명시합니다. 경쟁입찰은 예정가격 산출을 위해 간접비까지 상세하게 작성합니다.', small: '2천만원 이하 소규모 수선공사는 간이 내역서(품명·수량·단가)로 대체 가능. 별도 설계도면 없이 현장 사진+작업내용 기술로 갈음할 수 있습니다.', laws: [{ ref: '지방계약법 시행령 제2조 제1호', desc: '추정가격의 정의', href: '/topics/estimated-amount' }, { ref: '지방계약법 시행령 제7조', desc: '추정가격의 산정', href: '/topics/estimated-amount' }, { ref: '행정안전부 예규 「지방자치단체 입찰 및 계약집행기준」', desc: '예정가격 작성·원가계산 근거', href: '/topics/estimated-price' }, { ref: '건설공사 표준품셈 · 표준시장단가(실적공사비)', desc: '공사 예정가격 산정 기준', href: '/topics/estimated-price' }], docs: ['(내/설계용역)설계도면·시방서', '(내)물량내역서', '(내)내역서 단가근거[표준품셈·표준시장단가]'] },
  'construction-3' => { title: '계약 체결', num: 3, items: ['입찰 또는 수의계약 방식 결정 (공사: 종합 4억원/전문 2억원/기타 1.6억원 이하 수의계약)', '공사 유형별 발주: 종합공사 · 전문공사(전기·정보통신·소방 등) 구분', '전문공사(전기·정보통신·소방시설 등)는 해당 업종 등록업체에 분리발주', '건설업 등록증·시공능력 확인 (전문공사는 해당 업종 면허 확인)', '계약보증금, 계약이행보증서 징구', '안전관리비, 환경관리비 계약서에 명시'], tip: '전문공사(전기·정보통신·소방시설 등)는 해당 업종 등록업체에 분리발주가 원칙입니다 (건설산업기본법 제69조). 종합공사에 포함 발주 시 분리발주 의무 여부를 반드시 확인하세요.', small: '2천만원 이하: 1인 견적 가능. 5천만원 이하: 계약서 작성 생략 가능 (시행령 제50조). 전문공사는 금액 불문 해당 업종 등록업체 시공 필수 (전기공사업법, 정보통신공사업법, 소방시설공사업법 등).', docs: ['(내/외)계약서(또는 전자계약서)[안전·환경관리비 명시]', '(외)건설업 등록증·시공능력 확인', '(외)계약보증금·계약이행보증서, (내)면제 사유 검토·결정[공사 추정가격 1억원 이하 면제 가능]', '(외)사업자등록증·인감증명서·청렴서약서', '(내)부정당업자 조회'] },
  'construction-4' => { title: '착공', num: 4, items: ['착공계 제출 접수 (현장대리인 지정 신고서 포함)', '안전관리계획서 검토 및 승인', '산재·고용보험 현장적용 신고 확인', '공정표 제출 및 검토'], tip: '착공 전 안전관리계획서 승인이 반드시 선행되어야 합니다.', small: '소액공사는 착공계를 간이 서식으로 갈음 가능. 안전관리계획서는 건설기술진흥법령 기준 미해당 시 불요하나, 간단한 안전수칙 안내는 권장합니다.', docs: ['(외)착공계', '(외)현장대리인(건설기술인) 지정신고서', '(외)안전관리계획서', '(외)산재·고용보험 가입증명·공정표', '(내)안전관리계획 검토승인'] },
  'construction-5' => { title: '시공/감독', num: 5, items: ['공사감독일지 매일 작성 (기상, 인력, 장비, 작업내용)', '안전점검 정기 실시 (일일, 주간, 월간)', '품질시험 계획 대비 실시 확인', '설계변경 필요 시 사전 승인 후 시공'], tip: '감독일지는 분쟁 시 핵심 증거자료입니다. 빠짐없이 상세하게 기록하세요.', small: '소액공사도 감독일지 작성은 필수. 다만 주간 단위 약식 기록으로 갈음 가능. 품질시험은 대부분 불요하나, 공사 전·중·후 사진은 반드시 촬영하세요.', docs: ['(내)공사감독일지[매일]·안전점검 기록', '(외)작업일보', '공사 전·중·후 사진'] },
  'construction-6' => { title: '기성', num: 6, items: ['기성검사 실시 (공정률 또는 월별 기준)', '기성검사원 작성 및 결재', '기성금 청구서 및 세금계산서 접수', '노무비 지급 확인 후 기성금 지급'], tip: '기성금 지급 전 건설근로자 노무비 지급 확인이 필요합니다.', small: '단기 소액공사는 기성 단계 없이 준공 후 일시불 지급이 일반적. 기성금 분할지급은 공기가 긴 경우에만 적용합니다.', docs: ['(외)기성부분 검사원·기성금 청구서·세금계산서', '(내)기성검사조서', '(내)지출결의서[청구받은 날부터 5일 이내 지급]'] },
  'construction-7' => { title: '준공', num: 7, items: ['준공계 제출 접수 (준공기한 내 제출 확인)', '준공검사 실시 (준공계 제출 후 14일 이내)', '준공도면, 품질시험성과표, 공사사진첩 제출', '하자보증서 징구 (공종별 2~10년)'], tip: '하자보증기간은 공종별로 상이합니다: 구조물 10년, 마감 2년, 설비 3년 등.', small: '소액공사도 준공검사는 필수. 다만 준공도면은 생략 가능하고, 공사사진(전·후 비교)과 검사조서만으로 처리합니다. 하자보증서도 소액이라도 징구해야 합니다.', docs: ['(외)준공계·준공도면·공사사진첩', '(외)하자보수보증서·하자보수보증금[지방계약법 공종별 1~5년, 계약금액의 2~5%]', '(내)준공검사조서[추정가격 3천만원 초과 필수]'] },
  'construction-8' => { title: '하자관리', num: 8, items: ['하자담보책임기간 중 정기 점검 실시', '하자 발견 시 하자보수 요구 (서면 통보)', '하자보수 미이행 시 하자보증금으로 보수', '하자담보책임기간 만료 후 하자보증금 반환'], tip: '하자담보책임기간 만료 전 반드시 최종 점검을 실시하여 미발견 하자를 확인하세요.', small: '소액공사도 하자담보책임 적용. 다만 5천만원 이하로 계약서 생략 시에도 하자보증금 관련 사항을 서면으로 약정해두면 분쟁을 예방할 수 있습니다.', docs: ['(내)하자검사조서', '(내)하자보수 요구 공문[서면]', '(외)하자보수 완료계', '(내)하자보수보증금 반환청구서·반환결의(처리) 문서[기간 만료 후]'], final_docs: construction_final_docs }
