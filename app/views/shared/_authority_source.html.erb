<%# P1 §28 — Trust Block. 근거 / 적용 / 최근 확인 / 공식 원문을 한 덩어리로 보여준다.
    공개 가능한 값만 들어온다 — AuthorityPresenter 가 내부 메타데이터를 이미 차단한다.
    사용: render 'shared/authority_source', authority: AuthorityPresenter.new(@audit_case) %>
<% a = local_assigns[:authority] %>
<% if a && (a.show_source? || a.show_legal_references? || a.show_agency_scope?) %>
  <div class="rounded-xl border border-slate-200 bg-white p-4" aria-label="근거 및 출처">
    <p class="text-xs font-bold text-slate-900 flex items-center gap-1.5 mb-3">
      <span class="material-symbols-outlined text-slate-500 text-base" aria-hidden="true">verified_user</span>
      근거 및 출처
    </p>

    <dl class="space-y-3 text-xs">
      <% if a.show_legal_references? %>
        <div>
          <dt class="font-semibold text-slate-500 mb-1.5">법령 근거</dt>
          <dd><%= render 'shared/legal_references', references: a.legal_references %></dd>
        </div>
      <% end %>

      <% if a.show_agency_scope? %>
        <div>
          <dt class="font-semibold text-slate-500 mb-1">적용 대상</dt>
          <dd class="text-slate-800"><%= a.agency_labels.join(" · ") %></dd>
        </div>
      <% end %>

      <% if a.show_source? %>
        <div>
          <dt class="font-semibold text-slate-500 mb-1">출처</dt>
          <dd class="text-slate-800 leading-relaxed">
            <%= a.public_source_label %><%= " p.#{a.source_page}" if a.source_page.present? %>
            <% if a.source_url.present? %>
              <a href="<%= a.source_url %>" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1 ml-1 font-semibold text-indigo-700 hover:text-indigo-900 underline">
                공식 원문 보기
                <span class="material-symbols-outlined text-[13px]" aria-hidden="true">open_in_new</span>
              </a>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if a.effective_on.present? %>
        <div>
          <dt class="font-semibold text-slate-500 mb-1">기준일</dt>
          <dd class="text-slate-800"><time datetime="<%= a.effective_on.iso8601 %>"><%= l a.effective_on, format: :long rescue a.effective_on.strftime('%Y-%m-%d') %></time></dd>
        </div>
      <% end %>
    </dl>
  </div>
<% end %>
