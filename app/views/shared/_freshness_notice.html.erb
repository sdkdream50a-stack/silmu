<%# P1.5 §30·§31 — 공개 신선도 표시.
    법령이 바뀌었는데 검토가 끝나지 않았다면 **숨기지 않는다.**
    사용: render 'shared/freshness_notice', authority: @authority %>
<% a = local_assigns[:authority] %>
<% if a&.freshness_attention? %>
  <%
    status = a.freshness_status
    unavailable = status == "SOURCE_UNAVAILABLE"
    # Tailwind JIT 는 리터럴 클래스만 스캔한다 — 동적 조립 금지
    box  = unavailable ? "bg-slate-50 border-slate-200" : "bg-amber-50 border-amber-200"
    icon = unavailable ? "text-slate-500" : "text-amber-600"
    head = unavailable ? "text-slate-900" : "text-amber-900"
    body = unavailable ? "text-slate-700" : "text-amber-800"
    sym  = unavailable ? "cloud_off" : "update"
  %>
  <div class="<%= box %> border rounded-xl p-4" role="status" aria-label="법령 현행성 안내">
    <div class="flex items-start gap-2.5">
      <span class="material-symbols-outlined <%= icon %> text-lg shrink-0 mt-px" aria-hidden="true"><%= sym %></span>
      <div class="min-w-0">
        <p class="text-sm font-bold <%= head %> leading-tight">⚠ <%= a.freshness_label %></p>
        <p class="text-xs <%= body %> mt-1 leading-relaxed">
          <% if unavailable %>
            공식 출처를 일시적으로 확인할 수 없습니다. 중요한 업무 판단 전에는 공식 원문을 직접 확인해 주세요.
          <% else %>
            근거 법령의 개정이 감지되어 이 콘텐츠에 미치는 영향을 검토하고 있습니다.
            <strong>검토가 끝나기 전까지는 공식 원문을 함께 확인해 주세요.</strong>
          <% end %>
        </p>
        <% if (eff = a.pending_change_effective_on).present? %>
          <p class="text-[11px] <%= body %> mt-1.5">
            감지된 개정 시행일:
            <time datetime="<%= eff.iso8601 %>"><%= eff.strftime('%Y.%m.%d') %></time>
            <%= "(시행 예정)" if eff > Date.current %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
