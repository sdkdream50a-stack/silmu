<%# 예정가격(복수예비가격) 계산기 %>

<section class="section py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <%= link_to tools_path, class: "inline-flex items-center text-slate-600 hover:text-editorial-navy transition-colors font-medium" do %>
        <span class="material-symbols-outlined mr-1">arrow_back</span>
        도구 목록으로
      <% end %>
    </div>

    <div class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="icon-container icon-container-lg gradient-indigo shadow-lg">
          <span class="material-symbols-outlined text-3xl text-white">casino</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-900">예정가격 복수예비가격 계산기</h1>
          <p class="text-slate-500">기초금액에서 15개 예비가격을 만들고 4개 추첨 평균과 하한가를 시뮬레이션합니다</p>
          <%= render 'shared/use_when_badge', tool: 'predetermined-price' %>
        </div>
      </div>

      <div class="bg-editorial-navy-bg border border-editorial-navy-light rounded-2xl p-5">
        <h3 class="text-sm font-bold text-editorial-ink mb-2 flex items-center gap-2">
          <span class="material-symbols-outlined text-sm">gavel</span>
          계산 기준
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-editorial-navy-dark">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-editorial-navy">looks_one</span>
            15개 복수예비가격 생성
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-editorial-navy">looks_two</span>
            4개 추첨 산술평균
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-editorial-navy">looks_3</span>
            낙찰하한율 적용
          </div>
        </div>
        <p class="text-xs text-editorial-navy-dark/80 mt-3">
          <strong>근거:</strong> 지방계약법 시행령 제9조(예정가격의 결정방법)·제10조(예정가격의 결정기준),
          지방계약법 시행규칙 제4조(예정가격조서의 작성), 행정안전부 예규 「지방자치단체 입찰 및 계약집행기준」의 복수예비가격 운영 기준.
          실제 예정가격은 발주기관이 산정·등록합니다.
        </p>
      </div>
    </div>

    <div class="card p-6 mb-6">
      <h2 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-editorial-navy">tune</span>
        입력값
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div>
          <label for="base-amount" class="block text-sm font-semibold text-slate-700 mb-2">기초금액 (원)</label>
          <input type="text" id="base-amount" inputmode="numeric" placeholder="예: 100,000,000" class="form-input w-full" oninput="formatMoneyInput(this); calculatePredeterminedPrice(false);">
          <p class="text-xs text-slate-400 mt-1">복수예비가격 산출 기준 금액입니다</p>
        </div>
        <div>
          <label for="range-rate" class="block text-sm font-semibold text-slate-700 mb-2">복수예비가격 범위</label>
          <select id="range-rate" class="form-input w-full" onchange="calculatePredeterminedPrice(true)">
            <option value="2" selected>기초금액의 +/- 2%</option>
            <option value="3">기초금액의 +/- 3%</option>
          </select>
          <p class="text-xs text-slate-400 mt-1">공고·기관 기준에 맞는 범위를 선택하세요</p>
        </div>
        <div>
          <label for="floor-rate" class="block text-sm font-semibold text-slate-700 mb-2">낙찰하한율 (%)</label>
          <input type="number" id="floor-rate" placeholder="예: 87.745" step="0.001" min="0" max="100" class="form-input w-full" oninput="calculatePredeterminedPrice(false)">
          <p class="text-xs text-slate-400 mt-1">계약유형·금액·공고 기준에 따라 다릅니다</p>
        </div>
      </div>

      <div class="mt-5 flex flex-col sm:flex-row gap-3">
        <button type="button" onclick="calculatePredeterminedPrice(true)" class="btn btn-point btn-md justify-center">
          <span class="material-symbols-outlined">casino</span>
          15개 생성 + 4개 추첨
        </button>
        <button type="button" onclick="loadPredeterminedSample()" class="btn btn-secondary btn-md justify-center">
          <span class="material-symbols-outlined">science</span>
          샘플 입력
        </button>
        <button type="button" onclick="resetPredeterminedPrice()" class="btn btn-ghost btn-md justify-center">
          <span class="material-symbols-outlined">restart_alt</span>
          초기화
        </button>
      </div>
    </div>

    <div id="pp-empty-state" class="card p-6 border-2 border-dashed border-slate-200 mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-slate-400">preview</span>
        <h3 class="text-sm font-bold text-slate-700">계산 결과 미리보기</h3>
      </div>
      <p class="text-sm text-slate-500 leading-relaxed">
        기초금액을 입력하면 선택한 범위 안에서 15개 복수예비가격을 생성하고, 4개를 추첨하여 산술평균 예정가격을 계산합니다.
        낙찰하한율을 입력하면 예정가격에 비율을 곱한 하한가까지 함께 표시됩니다.
      </p>
    </div>

    <div id="pp-result-area" class="hidden space-y-6">
      <div class="card p-6 border-2 border-editorial-navy-light bg-editorial-navy-bg/30">
        <h2 class="text-base font-bold text-editorial-ink mb-5 flex items-center gap-2">
          <span class="material-symbols-outlined text-editorial-navy">calculate</span>
          예정가격 시뮬레이션 결과
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-5">
          <div class="bg-white rounded-xl p-4 text-center border border-editorial-navy-bg">
            <div class="text-xs text-slate-500 mb-1">기초금액</div>
            <div id="res-base" class="text-base font-bold text-slate-800">-</div>
          </div>
          <div class="bg-white rounded-xl p-4 text-center border border-editorial-navy-bg">
            <div class="text-xs text-slate-500 mb-1">선택 범위</div>
            <div id="res-range" class="text-base font-bold text-slate-800">-</div>
          </div>
          <div class="bg-white rounded-xl p-4 text-center border border-editorial-navy-bg">
            <div class="text-xs text-slate-500 mb-1">예정가격</div>
            <div id="res-predetermined" class="text-base font-bold text-editorial-navy">-</div>
          </div>
          <div class="bg-white rounded-xl p-4 text-center border border-editorial-navy-bg">
            <div class="text-xs text-slate-500 mb-1">하한가</div>
            <div id="res-floor-price" class="text-base font-bold text-emerald-700">-</div>
          </div>
        </div>

        <div id="res-floor-note" class="mb-5 p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-800">
          낙찰하한율은 공고문·적격심사 기준별로 다르므로 입력값을 반드시 확인하세요.
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <div class="bg-white rounded-xl border border-slate-100 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-100 flex items-center justify-between">
              <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-editorial-navy">format_list_numbered</span>
                15개 복수예비가격
              </h3>
              <span class="text-xs text-slate-400">선택된 4개는 강조 표시</span>
            </div>
            <div id="multiple-price-list" class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-4"></div>
          </div>

          <div class="bg-white rounded-xl border border-slate-100 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-100">
              <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-editorial-navy">functions</span>
                계산 과정
              </h3>
            </div>
            <div class="p-4 space-y-3 text-sm text-slate-700">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-xs font-bold flex items-center justify-center shrink-0">1</span>
                <p id="formula-range" class="leading-relaxed">-</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-700 text-xs font-bold flex items-center justify-center shrink-0">2</span>
                <p id="formula-draw" class="leading-relaxed">-</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold flex items-center justify-center shrink-0">3</span>
                <p id="formula-average" class="leading-relaxed">-</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-violet-100 text-violet-700 text-xs font-bold flex items-center justify-center shrink-0">4</span>
                <p id="formula-floor" class="leading-relaxed">-</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-editorial-navy">menu_book</span>
          법령·실무 근거
        </h2>
        <div class="space-y-3 text-sm text-slate-700 leading-relaxed">
          <p>
            <strong>예정가격 작성·결정:</strong> 지방계약법 시행령 제9조는 예정가격 결정방법의 기본 틀을 두고,
            제10조는 거래실례가격·원가계산·표준시장단가·감정가격 등 결정기준을 정합니다.
          </p>
          <p>
            <strong>복수예비가격:</strong> 15개 예비가격을 두고 그중 4개를 추첨해 산술평균하는 방식은 실무상 복수예비가격 운영 기준입니다.
            이 도구의 금액 생성은 절차 이해를 위한 무작위 시뮬레이션입니다.
          </p>
          <p class="text-red-700 bg-red-50 border border-red-100 rounded-xl p-3">
            <strong>면책:</strong> 참고용 시뮬레이션이며 실제 예정가격은 발주기관이 관련 법령·예규와 공고 조건에 따라 산정·등록합니다.
            낙찰하한율은 계약유형, 추정가격 구간, 적격심사 기준, 공고문에 따라 달라질 수 있습니다.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# P9 Information Scent — 이 도구 다음 단계 %>
<%= render 'shared/tool_next_actions',
  tool_key: 'predetermined-price',
  next_actions: [
    { type: 'topic', path: topic_path('estimated-price'), label: '함께 보는 토픽',
      title: '예정가격 산정 핵심', desc: '기초금액·복수예비가격·비공개 원칙 정리',
      icon: 'description', color: 'emerald' },
    { type: 'tool',  path: estimated_price_path, label: '관련 도구',
      title: '추정가격 계산기', desc: '원가항목 입력으로 추정가격 산출',
      icon: 'calculate', color: 'blue' },
    { type: 'tool',  path: qualification_evaluation_path, label: '다음 단계',
      title: '적격심사 자동 채점', desc: '예정가격 확정 후 점수 사전 검토',
      icon: 'fact_check', color: 'amber' }
  ]
%>

<script>
  let ppPrices = [];
  let ppDrawn = [];
  let ppLastBaseAmount = null;
  let ppLastRangeRate = null;

  function parseMoney(value) {
    return parseInt(String(value || '').replace(/[^\d]/g, ''), 10) || 0;
  }

  function formatWon(value) {
    return Math.round(value).toLocaleString('ko-KR') + '원';
  }

  function formatMoneyInput(input) {
    const value = parseMoney(input.value);
    input.value = value > 0 ? value.toLocaleString('ko-KR') : '';
  }

  function generateMultiplePrices(baseAmount, rangeRate) {
    const min = Math.floor(baseAmount * (1 - rangeRate / 100));
    const max = Math.ceil(baseAmount * (1 + rangeRate / 100));
    const used = new Set();
    const prices = [];

    while (prices.length < 15) {
      const candidate = Math.round(min + Math.random() * (max - min));
      if (!used.has(candidate)) {
        used.add(candidate);
        prices.push(candidate);
      }
    }

    return prices.sort((a, b) => a - b);
  }

  function drawFourPrices(prices) {
    const indexes = prices.map(function(_, index) { return index; });
    for (let i = indexes.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = indexes[i];
      indexes[i] = indexes[j];
      indexes[j] = temp;
    }
    return indexes.slice(0, 4).sort((a, b) => a - b);
  }

  function calculatePredeterminedPrice(regenerate) {
    const baseAmount = parseMoney(document.getElementById('base-amount').value);
    const rangeRate = parseFloat(document.getElementById('range-rate').value) || 2;
    const floorRateInput = document.getElementById('floor-rate').value;
    const floorRate = floorRateInput === '' ? null : parseFloat(floorRateInput);

    if (baseAmount <= 0) {
      document.getElementById('pp-result-area').classList.add('hidden');
      document.getElementById('pp-empty-state').classList.remove('hidden');
      return;
    }

    if (regenerate || ppPrices.length !== 15 || ppLastBaseAmount !== baseAmount || ppLastRangeRate !== rangeRate) {
      ppPrices = generateMultiplePrices(baseAmount, rangeRate);
      ppDrawn = drawFourPrices(ppPrices);
      ppLastBaseAmount = baseAmount;
      ppLastRangeRate = rangeRate;
    }

    const drawnPrices = ppDrawn.map(function(index) { return ppPrices[index]; });
    const sum = drawnPrices.reduce(function(total, price) { return total + price; }, 0);
    const predeterminedPrice = Math.floor(sum / drawnPrices.length);
    const floorPrice = floorRate !== null && floorRate > 0 ? Math.floor(predeterminedPrice * floorRate / 100) : null;
    const minPrice = Math.floor(baseAmount * (1 - rangeRate / 100));
    const maxPrice = Math.ceil(baseAmount * (1 + rangeRate / 100));

    document.getElementById('pp-empty-state').classList.add('hidden');
    document.getElementById('pp-result-area').classList.remove('hidden');
    document.getElementById('res-base').textContent = formatWon(baseAmount);
    document.getElementById('res-range').textContent = '+/- ' + rangeRate.toFixed(0) + '%';
    document.getElementById('res-predetermined').textContent = formatWon(predeterminedPrice);
    document.getElementById('res-floor-price').textContent = floorPrice === null ? '비율 입력 필요' : formatWon(floorPrice);

    const floorNote = document.getElementById('res-floor-note');
    floorNote.textContent = floorRate === null
      ? '낙찰하한율을 입력하면 예정가격에 해당 비율을 곱한 하한가를 계산합니다. 비율은 공고문 기준으로 확인하세요.'
      : '하한가는 입력한 낙찰하한율 ' + floorRate.toFixed(3) + '%를 단순 적용한 참고값입니다. 실제 적용 기준은 공고문과 적격심사 기준을 확인하세요.';

    renderMultiplePriceList();

    document.getElementById('formula-range').innerHTML =
      '범위: ' + formatWon(baseAmount) + ' x (' + (100 - rangeRate).toFixed(0) + '% ~ ' + (100 + rangeRate).toFixed(0) + '%) = ' +
      formatWon(minPrice) + ' ~ ' + formatWon(maxPrice);
    document.getElementById('formula-draw').innerHTML =
      '추첨 4개: ' + drawnPrices.map(formatWon).join(' + ');
    document.getElementById('formula-average').innerHTML =
      '예정가격: (' + drawnPrices.map(function(price) { return price.toLocaleString('ko-KR'); }).join(' + ') + ') / 4 = <strong>' + formatWon(predeterminedPrice) + '</strong>';
    document.getElementById('formula-floor').innerHTML = floorPrice === null
      ? '하한가: 낙찰하한율을 입력하면 계산됩니다.'
      : '하한가: ' + formatWon(predeterminedPrice) + ' x ' + floorRate.toFixed(3) + '% = <strong>' + formatWon(floorPrice) + '</strong>';
  }

  function renderMultiplePriceList() {
    const list = document.getElementById('multiple-price-list');
    list.innerHTML = '';

    ppPrices.forEach(function(price, index) {
      const selected = ppDrawn.includes(index);
      const item = document.createElement('div');
      item.className = selected
        ? 'rounded-lg border-2 border-emerald-400 bg-emerald-50 p-3'
        : 'rounded-lg border border-slate-100 bg-slate-50 p-3';
      item.innerHTML =
        '<div class="flex items-center justify-between mb-1">' +
          '<span class="text-xs font-semibold ' + (selected ? 'text-emerald-700' : 'text-slate-400') + '">No. ' + (index + 1) + '</span>' +
          (selected ? '<span class="material-symbols-outlined text-emerald-600" style="font-size:16px">check_circle</span>' : '') +
        '</div>' +
        '<div class="text-sm font-bold ' + (selected ? 'text-emerald-800' : 'text-slate-700') + '">' + formatWon(price) + '</div>';
      list.appendChild(item);
    });
  }

  function loadPredeterminedSample() {
    document.getElementById('base-amount').value = '100,000,000';
    document.getElementById('range-rate').value = '2';
    document.getElementById('floor-rate').value = '87.745';
    calculatePredeterminedPrice(true);
  }

  function resetPredeterminedPrice() {
    document.getElementById('base-amount').value = '';
    document.getElementById('range-rate').value = '2';
    document.getElementById('floor-rate').value = '';
    ppPrices = [];
    ppDrawn = [];
    ppLastBaseAmount = null;
    ppLastRangeRate = null;
    document.getElementById('pp-result-area').classList.add('hidden');
    document.getElementById('pp-empty-state').classList.remove('hidden');
  }
</script>
