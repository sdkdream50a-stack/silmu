<%# 예산 집행률 계산기 %>

<%
  # P0-2 — 이 도구의 «참고선» 은 산술(균등 배분)이다. 법정 목표율이 아니다.
  #   지방재정법 전문에 «집행률»·«목표율»·«집행 목표» 는 0건이다(2026-09-18 법령 원문 대조).
  #   그래서 예전 분기 목표치 해시(3월 25 · 6월 50 · 9월 75 · 12월 90)는 삭제했다 —
  #   출처가 코드 주석뿐이었고(SOURCE=NONE) 12월 90% 는 균등 배분도 아니었다.
  #
  # 회계연도 시작월은 기관마다 다르다: 지방자치단체 1월 / 학교회계 3월.
  #   서버는 1월을 기본으로 렌더하고(공유 CDN 캐시 안전), 학교 분기는 클라이언트에서만 한다.
  today = Time.zone.today
  current_month = today.month
  default_fiscal_start = 1
  # 균등 배분 참고선 = 회계연도 경과 월수 ÷ 12
  elapsed_months = ((current_month - default_fiscal_start) % 12) + 1
  reference_rate = (elapsed_months / 12.0 * 100).round(1)
  year_progress = ((today.yday / (Date.new(today.year, 12, 31).yday).to_f) * 100).round(1)
%>

<section class="section py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 뒤로가기 -->
    <div class="mb-6">
      <%= link_to tools_path, class: "inline-flex items-center text-slate-600 hover:text-editorial-navy transition-colors font-medium" do %>
        <span class="material-symbols-outlined mr-1">arrow_back</span>
        도구 목록으로
      <% end %>
    </div>

    <!-- 페이지 헤더 -->
    <div class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="icon-container icon-container-lg gradient-indigo shadow-lg">
          <span class="material-symbols-outlined text-3xl text-white">bar_chart</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-900">예산 집행률 계산기</h1>
          <p class="text-slate-500">예산 집행 현황과 균등 배분 참고선 대비 차이를 즉시 파악하세요</p>
          <%= render 'shared/use_when_badge', tool: 'budget-execution-rate' %>
        </div>
      </div>

      <%= render 'shared/jurisdiction_notice', tool_key: 'budget-execution-rate' %>

      <details class="bg-white rounded-2xl shadow-sm border border-editorial-navy-bg mt-6">
        <summary class="px-6 py-4 cursor-pointer hover:bg-slate-50 transition-colors flex items-center gap-2 [list-style:none] [&::-webkit-details-marker]:hidden">
          <span class="material-symbols-outlined text-editorial-navy text-[20px]">info</span>
          <span class="text-sm font-semibold text-slate-700">이 도구를 사용하는 이유</span>
          <span class="ml-auto text-xs text-slate-400">펼치기 ▾</span>
        </summary>
        <div class="px-6 pb-6 prose prose-slate prose-sm max-w-none">
          <p class="text-slate-700 leading-relaxed mb-3">
            예산 집행률은 배정예산 대비 실제 집행액의 비율로, 사업 진행도와 예산 관리 현황을 한눈에 보여주는 핵심 지표입니다.
            집행 부진은 실제로 재정 운영 점검·다음 연도 편성 심의에서 다뤄지지만, <strong>법령이 정한 분기·연도말 집행 목표율은 없습니다</strong>.
            지방재정법 제40조는 예산의 내용, 제47조는 목적 외 사용금지를 정하며 집행률을 다루지 않습니다(법령 전문에 «집행률»·«목표율» 0건, 2026-09-18 원문 대조).
            목표율이 있다면 그것은 소속 기관·상급기관의 <strong>당해연도 집행계획·지침</strong>에서 나옵니다.
          </p>
          <p class="text-slate-700 leading-relaxed mb-3">
            이 도구는 예산 항목별 집행률과 잔액을 자동 계산하고, <strong>균등 배분 참고선과의 차이</strong>를 바로 알 수 있도록 설계되었습니다.
            참고선은 «회계연도 경과 월수 ÷ 12» 라는 산술이며, 공식 기준이 아닙니다.
          </p>
          <div class="bg-amber-50 border-l-4 border-amber-500 p-3 rounded-r-lg mt-4">
            <p class="text-amber-900 text-xs leading-relaxed">
              <strong>⚠️ 참고선의 성격:</strong> 이 화면의 참고선은 <strong>내부 참고용 균등 배분선</strong>입니다(공식 목표 아님).
              사업 특성(하반기 집중·계절성·계약 시기)에 따라 정상적으로 달라지므로, 판정은 소속 기관의 집행계획서로 합니다.
            </p>
          </div>
        </div>
      </details>
    </div>

    <div class="lg:flex lg:gap-8">
      <!-- 입력 폼 -->
      <div class="lg:w-1/2 mb-8 lg:mb-0">
        <div class="card p-6">
          <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-editorial-navy">edit</span>
            예산 정보 입력
          </h2>

          <!-- 회계연도 시작월 — P0-2: 학교회계는 3월 시작이라 경과 월수가 다르다 -->
          <div class="mb-5">
            <label for="fiscal-start-month" class="block text-sm font-semibold text-slate-700 mb-2">회계연도 시작월</label>
            <select id="fiscal-start-month" class="form-input w-full" onchange="calculate()">
              <option value="1"<%= ' selected' if default_fiscal_start == 1 %>>1월 — 지방자치단체·국가 (1.1~12.31)</option>
              <option value="3"<%= ' selected' if default_fiscal_start == 3 %>>3월 — 학교회계 (3.1~다음 해 2월 말)</option>
            </select>
            <p class="text-xs text-slate-400 mt-1">학교·교육행정 사용자는 <strong>3월</strong>을 선택하세요. 경과 월수가 달라 참고선이 바뀝니다.</p>
          </div>

          <!-- 기준 월 -->
          <div class="mb-5">
            <label for="base-month" class="block text-sm font-semibold text-slate-700 mb-2">기준 월</label>
            <select id="base-month" class="form-input w-full" onchange="calculate()">
              <% (1..12).each do |m| %>
                <option value="<%= m %>"<%= ' selected' if m == current_month %>><%= m %>월</option>
              <% end %>
            </select>
            <p class="text-xs text-slate-400 mt-1">현재 기준으로 삼을 월을 선택하세요</p>
          </div>

          <!-- 예산 항목 입력 -->
          <div id="items-container">
            <!-- 항목 1 (기본) -->
            <div class="budget-item border border-slate-100 rounded-xl p-4 mb-4 bg-slate-50/50">
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-semibold text-slate-600">항목 1</span>
                <button type="button" onclick="removeItem(this)" class="text-slate-300 hover:text-red-500 transition-colors hidden">
                  <span class="material-symbols-outlined text-base">close</span>
                </button>
              </div>
              <div class="mb-3">
                <label class="block text-xs font-medium text-slate-600 mb-1">항목명 (선택)</label>
                <input type="text" placeholder="예: 도로유지보수비" class="form-input w-full text-sm" oninput="calculate()">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-slate-600 mb-1">예산액 (천원)</label>
                  <input type="number" placeholder="예: 50,000" min="0" class="form-input w-full text-sm budget-amount" oninput="calculate()">
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-600 mb-1">집행액 (천원)</label>
                  <input type="number" placeholder="예: 28,500" min="0" class="form-input w-full text-sm executed-amount" oninput="calculate()">
                </div>
              </div>
            </div>
          </div>

          <!-- 항목 추가 버튼 -->
          <button type="button" onclick="addItem()" class="w-full py-2.5 border-2 border-dashed border-slate-200 rounded-xl text-sm text-slate-400 hover:border-editorial-navy-light hover:text-editorial-navy transition-all flex items-center justify-center gap-1 mb-4">
            <span class="material-symbols-outlined text-base">add</span>
            항목 추가
          </button>

          <!-- 계산 버튼 -->
          <button type="button" onclick="calculate()" class="w-full btn btn-point btn-md">
            <span class="material-symbols-outlined">calculate</span>
            집행률 계산
          </button>
        </div>
      </div>

      <!-- 결과 -->
      <div class="lg:w-1/2">
        <div class="card p-6 h-full">
          <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-editorial-navy">analytics</span>
            집행률 분석 결과
          </h2>

          <!-- 초기 안내 — 균등 배분 참고선 카드 + 샘플 시작 (Information Scent) -->
          <div id="empty-state">
            <!-- 균등 배분 참고선 카드 — 공식 목표가 아니라는 것을 카드 안에서 말한다(P0-2) -->
            <div class="bg-gradient-to-br from-editorial-navy-bg to-emerald-50/40 border border-editorial-navy-light rounded-xl p-5 mb-4">
              <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-editorial-navy" style="font-size:18px">trending_up</span>
                <span class="text-xs font-bold text-editorial-navy uppercase tracking-wider">균등 배분 참고선</span>
                <span class="text-[10px] font-semibold text-slate-600 bg-white/80 border border-slate-300 rounded-full px-2 py-0.5">참고용 · 공식 목표 아님</span>
              </div>
              <p class="text-[11px] text-slate-500 mb-3">회계연도 경과 월수 ÷ 12 (산술)</p>
              <div class="flex items-end gap-3 mb-2">
                <div id="reference-rate-value" class="text-4xl font-bold text-editorial-navy-dark"><%= reference_rate %>%</div>
                <div id="reference-rate-caption" class="text-sm text-slate-500 pb-1.5"><%= current_month %>월 = 회계연도 <%= elapsed_months %>개월 경과</div>
              </div>
              <div class="bg-white/70 rounded-full h-2 overflow-hidden mb-2">
                <div id="reference-rate-bar" class="h-full bg-editorial-navy rounded-full" style="width: <%= reference_rate %>%"></div>
              </div>
              <div class="flex justify-between text-[11px] text-slate-500 mb-3">
                <span>경과 0개월 0%</span>
                <span>6개월 50%</span>
                <span>12개월 100%</span>
              </div>
              <div class="bg-white/60 rounded-lg p-2 text-xs">
                <div class="text-slate-400 text-[10px] uppercase tracking-wide">달력 경과 (회계연도와 다를 수 있음)</div>
                <div class="font-bold text-slate-700"><%= year_progress %>% (<%= today.strftime('%-m/%-d') %>)</div>
              </div>
            </div>

            <!-- 샘플 데이터로 시작 (Empty State Work) -->
            <button type="button" onclick="loadSampleData()"
                    class="w-full py-3 px-4 bg-violet-50 hover:bg-violet-100 border border-violet-200 rounded-xl text-sm font-medium text-violet-700 transition-colors flex items-center justify-center gap-2">
              <span class="material-symbols-outlined" style="font-size:18px">auto_awesome</span>
              샘플 데이터로 미리보기
            </button>
            <p class="text-[11px] text-slate-400 text-center mt-2">3개 예산 항목으로 즉시 결과 확인</p>
          </div>

          <!-- 결과 영역 -->
          <div id="result-area" class="hidden">
            <!-- 전체 요약 -->
            <div class="bg-editorial-navy-bg rounded-xl p-4 mb-5">
              <div class="text-sm text-editorial-navy font-medium mb-1">전체 예산 집행률</div>
              <div class="flex items-end gap-3">
                <div id="total-rate" class="text-4xl font-bold text-editorial-navy-dark">0%</div>
                <div id="rate-status" class="text-sm font-semibold pb-1"></div>
              </div>
              <!-- 진행바 -->
              <div class="mt-3 bg-white rounded-full h-3 overflow-hidden">
                <div id="total-bar" class="h-full rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>
              <div class="flex justify-between text-xs text-editorial-navy-light mt-1">
                <span>0%</span>
                <span id="target-rate-label">참고선 0%</span>
                <span>100%</span>
              </div>
            </div>

            <!-- 수치 요약 -->
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div class="bg-white border border-slate-100 rounded-xl p-3 text-center">
                <div class="text-xs text-slate-400 mb-1">총 예산액</div>
                <div id="total-budget" class="text-base font-bold text-slate-800">-</div>
                <div class="text-xs text-slate-400">천원</div>
              </div>
              <div class="bg-white border border-slate-100 rounded-xl p-3 text-center">
                <div class="text-xs text-slate-400 mb-1">총 집행액</div>
                <div id="total-executed" class="text-base font-bold text-green-600">-</div>
                <div class="text-xs text-slate-400">천원</div>
              </div>
              <div class="bg-white border border-slate-100 rounded-xl p-3 text-center">
                <div class="text-xs text-slate-400 mb-1">미집행 잔액</div>
                <div id="total-balance" class="text-base font-bold text-amber-600">-</div>
                <div class="text-xs text-slate-400">천원</div>
              </div>
            </div>

            <!-- 항목별 결과 -->
            <div id="items-result" class="space-y-3">
            </div>

            <!-- 집행 속도 분석 -->
            <div id="speed-analysis" class="mt-4 p-4 rounded-xl border text-sm"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 집행률 기준 안내 -->
    <div class="mt-8 card p-6">
      <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-600">lightbulb</span>
        예산 집행률 가이드
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="bg-green-50 rounded-xl p-4">
          <div class="font-semibold text-green-800 mb-2">✅ 참고선 관리 (공식 기준 아님)</div>
          <ul class="text-green-700 space-y-1 text-xs">
            <li>• 균등 배분 참고선(경과 월수÷12) 근처를 유지</li>
            <li>• 참고선과 벌어지면 사업 특성·계약 시기로 설명 가능해야 함</li>
            <li>• 이월 최소화: 명시이월·사고이월 사유 명확히</li>
          </ul>
        </div>
        <div class="bg-red-50 rounded-xl p-4">
          <div class="font-semibold text-red-800 mb-2">⚠️ 집행 부진 시 조치</div>
          <ul class="text-red-700 space-y-1 text-xs">
            <li>• 집행 부진 원인 분석 및 보고</li>
            <li>• 불용 예산 예비비 전입 또는 이용·전용 검토</li>
            <li>• 다음 연도 예산 편성 시 삭감 가능</li>
          </ul>
        </div>
        <div class="bg-blue-50 rounded-xl p-4">
          <div class="font-semibold text-blue-800 mb-2">📌 집행 서두르면 안 되는 경우</div>
          <ul class="text-blue-700 space-y-1 text-xs">
            <li>• 경상 지출(인건비·운영비): 계획대로 집행</li>
            <li>• 사업비: 사업 진행률에 맞춰 집행</li>
            <li>• 억지 집행(불필요한 구매 등)은 감사 지적 대상</li>
          </ul>
        </div>
        <div class="bg-purple-50 rounded-xl p-4">
          <div class="font-semibold text-purple-800 mb-2">📊 집행률 산정 방법</div>
          <ul class="text-purple-700 space-y-1 text-xs">
            <li>• 집행률 = 집행액 ÷ 예산액 × 100</li>
            <li>• 집행액 = 지출액 + 지출원인행위액</li>
            <li>• 예산액 = 당초예산 + 추가경정예산</li>
          </ul>
        </div>
        <%= render 'shared/ad_slot', position: 'tool-result' %>
      </div>
    </div>
  </div>
</section>

<%# P9 Information Scent — 이 도구 다음 단계 %>
<%= render 'shared/tool_next_actions',
  tool_key: 'budget-execution-rate',
  next_actions: [
    { type: 'guide', path: guide_path('budget-carryover-guide'), label: '단계별 가이드',
      title: '예산 이월·전용 단계별 가이드', desc: '집행 부진 시 이월·전용 절차와 사유 문서화',
      icon: 'menu_book', color: 'emerald' },
    { type: 'tool',  path: budget_transfer_checker_path, label: '바로 계산',
      title: '이월·전용 판단기', desc: '사고이월 요건·전용 금지 케이스 즉시 확인',
      icon: 'swap_horiz', color: 'amber' },
    { type: 'tool',  path: contingency_fund_path, label: '관련 도구',
      title: '예비비 집행 점검', desc: '예측불가 사유 + 소명자료 체크리스트',
      icon: 'savings', color: 'blue' }
  ]
%>

<script>
  let itemCount = 1;

  // P0-2 — 회계연도 시작월을 반영한 경과 월수. 지방자치단체 1월 시작 / 학교회계 3월 시작.
  //   fiscalElapsedMonths(9, 1) = 9  ·  fiscalElapsedMonths(9, 3) = 7
  function fiscalStartMonth() {
    const el = document.getElementById('fiscal-start-month');
    const v = el ? parseInt(el.value) : 1;
    return (v >= 1 && v <= 12) ? v : 1;
  }

  function fiscalElapsedMonths(baseMonth, startMonth) {
    return (((baseMonth - startMonth) % 12) + 12) % 12 + 1;
  }

  // 균등 배분 참고선(%) — 산술이다. 법정 목표율이 아니다.
  function referenceRatePercent() {
    const base = parseInt(document.getElementById('base-month').value);
    return (fiscalElapsedMonths(base, fiscalStartMonth()) / 12) * 100;
  }

  // 페이지 로드 시 현재 월로 기준 월 설정 (SSR ERB와 sync — JS는 fallback safety net)
  // 학교(sector=edu) 쿠키가 있으면 회계연도 시작월을 3월로 미리 맞춘다.
  //   ⚠️ 서버에서 하지 않는 이유 = 이 페이지는 CDN 공유 캐시(public, max-age=14400)이고
  //      Vary 에 Cookie 가 없다. 서버 분기는 캐시를 섞는다.
  document.addEventListener('DOMContentLoaded', function() {
    const now = new Date();
    const month = now.getMonth() + 1;
    document.getElementById('base-month').value = month;

    if (/(?:^|;\s*)sector=edu(?:;|$)/.test(document.cookie)) {
      const fs = document.getElementById('fiscal-start-month');
      if (fs) fs.value = '3';
    }
    updateReferenceCard();
  });

  // 참고선 카드(빈 상태)를 회계연도 선택에 맞춰 갱신
  function updateReferenceCard() {
    const base = parseInt(document.getElementById('base-month').value);
    const elapsed = fiscalElapsedMonths(base, fiscalStartMonth());
    const rate = (elapsed / 12) * 100;
    const v = document.getElementById('reference-rate-value');
    const c = document.getElementById('reference-rate-caption');
    const b = document.getElementById('reference-rate-bar');
    if (v) v.textContent = rate.toFixed(1) + '%';
    if (c) c.textContent = `${base}월 = 회계연도 ${elapsed}개월 경과`;
    if (b) b.style.width = Math.min(rate, 100) + '%';
  }

  // 샘플 데이터로 미리보기 (Empty State Work — Schoger)
  function loadSampleData() {
    const targetRate = referenceRatePercent() / 100;
    // 참고선 ±10% 분포로 3개 항목 — 양호·약간 부진·부진 색상이 동시 노출되도록 의도
    const samples = [
      { name: '도로유지보수비', budget: 50000, rate: targetRate + 0.05 },
      { name: '청사 운영비',     budget: 30000, rate: targetRate - 0.03 },
      { name: '사업비',           budget: 20000, rate: targetRate - 0.18 }
    ];
    const container = document.getElementById('items-container');
    container.innerHTML = '';
    itemCount = 0;
    samples.forEach((s, i) => {
      addItem();
      const items = container.querySelectorAll('.budget-item');
      const last = items[items.length - 1];
      last.querySelector('input[type="text"]').value = s.name;
      last.querySelector('.budget-amount').value = s.budget;
      last.querySelector('.executed-amount').value = Math.round(s.budget * Math.max(s.rate, 0));
    });
    calculate();
  }

  function addItem() {
    itemCount++;
    const container = document.getElementById('items-container');
    const div = document.createElement('div');
    div.className = 'budget-item border border-slate-100 rounded-xl p-4 mb-4 bg-slate-50/50';
    div.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm font-semibold text-slate-600">항목 ${itemCount}</span>
        <button type="button" onclick="removeItem(this)" class="text-slate-300 hover:text-red-500 transition-colors">
          <span class="material-symbols-outlined text-base">close</span>
        </button>
      </div>
      <div class="mb-3">
        <label class="block text-xs font-medium text-slate-600 mb-1">항목명 (선택)</label>
        <input type="text" placeholder="예: 청사유지보수비" class="form-input w-full text-sm" oninput="calculate()">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">예산액 (천원)</label>
          <input type="number" placeholder="0" min="0" class="form-input w-full text-sm budget-amount" oninput="calculate()">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">집행액 (천원)</label>
          <input type="number" placeholder="0" min="0" class="form-input w-full text-sm executed-amount" oninput="calculate()">
        </div>
      </div>
    `;
    container.appendChild(div);
    // 첫 항목 삭제 버튼 표시
    const firstRemoveBtn = container.querySelector('.budget-item .hidden');
    if (firstRemoveBtn) firstRemoveBtn.classList.remove('hidden');
  }

  function removeItem(btn) {
    const item = btn.closest('.budget-item');
    item.remove();
    // 항목이 1개만 남으면 삭제 버튼 숨기기
    const items = document.querySelectorAll('.budget-item');
    if (items.length === 1) {
      const removeBtn = items[0].querySelector('button[onclick="removeItem(this)"]');
      if (removeBtn) removeBtn.classList.add('hidden');
    }
    calculate();
  }

  function calculate() {
    const month = parseInt(document.getElementById('base-month').value);
    const elapsedMonths = fiscalElapsedMonths(month, fiscalStartMonth());
    const targetRate = referenceRatePercent();
    updateReferenceCard();

    const items = document.querySelectorAll('.budget-item');
    let totalBudget = 0, totalExecuted = 0;
    const itemResults = [];

    items.forEach((item, idx) => {
      const nameInput = item.querySelector('input[type="text"]');
      const budgetInput = item.querySelector('.budget-amount');
      const executedInput = item.querySelector('.executed-amount');

      const name = nameInput ? nameInput.value.trim() || `항목 ${idx + 1}` : `항목 ${idx + 1}`;
      const budget = parseFloat(budgetInput?.value) || 0;
      const executed = parseFloat(executedInput?.value) || 0;

      if (budget > 0) {
        totalBudget += budget;
        totalExecuted += executed;
        const rate = (executed / budget) * 100;
        itemResults.push({ name, budget, executed, rate });
      }
    });

    if (totalBudget === 0) {
      document.getElementById('empty-state').classList.remove('hidden');
      document.getElementById('result-area').classList.add('hidden');
      return;
    }

    const totalRate = (totalExecuted / totalBudget) * 100;
    const totalBalance = totalBudget - totalExecuted;

    document.getElementById('empty-state').classList.add('hidden');
    document.getElementById('result-area').classList.remove('hidden');

    // 전체 집행률
    document.getElementById('total-rate').textContent = totalRate.toFixed(1) + '%';
    document.getElementById('target-rate-label').textContent = `참고선 ${targetRate.toFixed(0)}%`;

    // 진행바 색상
    const bar = document.getElementById('total-bar');
    if (totalRate >= targetRate) {
      bar.className = 'h-full rounded-full transition-all duration-500 bg-green-500';
    } else if (totalRate >= targetRate * 0.8) {
      bar.className = 'h-full rounded-full transition-all duration-500 bg-amber-400';
    } else {
      bar.className = 'h-full rounded-full transition-all duration-500 bg-red-400';
    }
    bar.style.width = Math.min(totalRate, 100) + '%';

    // 상태 텍스트
    const statusEl = document.getElementById('rate-status');
    const diff = totalRate - targetRate;
    if (diff >= 5) {
      statusEl.textContent = '▲ 참고선 초과';
      statusEl.className = 'text-sm font-semibold pb-1 text-green-600';
    } else if (diff >= 0) {
      statusEl.textContent = '✅ 참고선 도달';
      statusEl.className = 'text-sm font-semibold pb-1 text-green-600';
    } else if (diff >= -10) {
      statusEl.textContent = '⚡ 약간 부진';
      statusEl.className = 'text-sm font-semibold pb-1 text-amber-600';
    } else {
      statusEl.textContent = '⚠️ 집행 부진';
      statusEl.className = 'text-sm font-semibold pb-1 text-red-600';
    }

    // 수치
    document.getElementById('total-budget').textContent = formatNum(totalBudget);
    document.getElementById('total-executed').textContent = formatNum(totalExecuted);
    document.getElementById('total-balance').textContent = formatNum(totalBalance);

    // 항목별 결과
    const itemsResult = document.getElementById('items-result');
    itemsResult.innerHTML = itemResults.map(item => {
      const rate = item.rate;
      let colorClass, bgClass;
      if (rate >= targetRate) { colorClass = 'text-green-600'; bgClass = 'bg-green-50'; }
      else if (rate >= targetRate * 0.8) { colorClass = 'text-amber-600'; bgClass = 'bg-amber-50'; }
      else { colorClass = 'text-red-600'; bgClass = 'bg-red-50'; }

      return `
        <div class="${bgClass} rounded-xl p-3">
          <div class="flex justify-between items-center mb-1">
            <span class="text-sm font-semibold text-slate-700">${item.name}</span>
            <span class="text-sm font-bold ${colorClass}">${rate.toFixed(1)}%</span>
          </div>
          <div class="bg-white/80 rounded-full h-2 overflow-hidden mb-1">
            <div class="h-full rounded-full ${rate >= targetRate ? 'bg-green-500' : rate >= targetRate * 0.8 ? 'bg-amber-400' : 'bg-red-400'}" style="width: ${Math.min(rate, 100)}%"></div>
          </div>
          <div class="flex justify-between text-xs text-slate-500">
            <span>집행 ${formatNum(item.executed)}천원</span>
            <span>잔액 ${formatNum(item.budget - item.executed)}천원</span>
          </div>
        </div>
      `;
    }).join('');

    // 집행 속도 분석
    const analysis = document.getElementById('speed-analysis');
    const remainingMonths = 12 - elapsedMonths;
    const remainingBalance = totalBalance;
    const monthlyNeeded = remainingMonths > 0 ? remainingBalance / remainingMonths : 0;

    if (diff >= 0) {
      analysis.className = 'mt-4 p-4 rounded-xl border text-sm bg-green-50 border-green-200 text-green-800';
      analysis.innerHTML = `
        <div class="font-semibold mb-1">✅ 참고선 이상</div>
        <div class="text-xs leading-relaxed">
          현재 집행률이 균등 배분 참고선(${targetRate.toFixed(0)}%)에 도달했습니다. 참고선은 공식 목표가 아닙니다.
          ${remainingMonths > 0 ? `남은 ${remainingMonths}개월간 매월 약 <strong>${formatNum(Math.round(monthlyNeeded))}천원</strong> 집행 시 연말 ${((totalExecuted + remainingBalance) / totalBudget * 100).toFixed(0)}% 달성` : '연말 결산을 준비하세요.'}
        </div>
      `;
    } else {
      analysis.className = 'mt-4 p-4 rounded-xl border text-sm bg-amber-50 border-amber-200 text-amber-800';
      analysis.innerHTML = `
        <div class="font-semibold mb-1">⚡ 집행 가속 필요</div>
        <div class="text-xs leading-relaxed">
          균등 배분 참고선(${targetRate.toFixed(0)}%) 대비 <strong>${Math.abs(diff).toFixed(1)}%p</strong> 낮습니다. 사업 특성상 정상일 수 있으므로 소속 기관 집행계획서로 판정하세요.
          ${remainingMonths > 0 ? `남은 ${remainingMonths}개월간 매월 약 <strong>${formatNum(Math.round(monthlyNeeded))}천원</strong> 이상 집행이 필요합니다.` : '연도 마감 전 긴급 집행 방안을 검토하세요.'}
        </div>
      `;
    }
  }

  function formatNum(n) {
    return Math.round(n).toLocaleString('ko-KR');
  }
</script>
