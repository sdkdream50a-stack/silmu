<%# 분할계약 판단 체크리스트 %>

<section class="section py-10">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 뒤로가기 -->
    <div class="mb-6">
      <%= link_to tools_path, class: "inline-flex items-center text-slate-600 hover:text-red-600 transition-colors font-medium" do %>
        <span class="material-symbols-outlined mr-1">arrow_back</span>
        도구 목록으로
      <% end %>
    </div>

    <!-- 페이지 헤더 -->
    <div class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="icon-container icon-container-lg gradient-rose shadow-lg">
          <span class="material-symbols-outlined text-3xl text-white">rule</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-900">분할계약 판단 체크리스트</h1>
          <p class="text-slate-500">계약 분할이 감사 지적 대상인지 즉시 확인하세요</p>
          <%= render 'shared/use_when_badge', tool: 'split-contract-checker' %>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3">
        <p class="text-slate-800 text-sm leading-relaxed">
          <strong>나눠서 계약했다고 모두 위법인 것은 아닙니다.</strong>
          법령상 분리발주가 요구되는 공사도 있고, 공종·설계서가 명확히 구분되면 분리 시공이 허용됩니다.
          문제가 되는 것은 <strong>한도나 경쟁을 회피할 목적</strong>의 분할입니다.
        </p>
        <p class="text-slate-700 text-sm leading-relaxed">
          <strong>공사와 물품·용역은 근거 조문이 다릅니다.</strong>
        </p>
        <ul class="text-slate-700 text-sm leading-relaxed list-disc pl-5 space-y-1">
          <li>
            <strong>공사</strong> — 지방계약법 시행령 <strong>제77조제1항</strong>이 동일 구조물·단일공사로서
            전체 사업내용이 확정된 공사의 시기적·공사량 분할을 금지합니다.
            같은 항 제1~3호는 분리가 허용되는 경우이고, <strong>제77조제3항</strong>은 그 경우에도
            수의계약 회피 목적의 분할을 금지합니다.
          </li>
          <li>
            <strong>물품·용역</strong> — 제77조는 공사 조항이라 적용되지 않습니다. 대신
            시행령 <strong>제7조제2호</strong>가 분할되어 이루어지는 계약의 추정가격을
            <strong>직전 12개월 또는 해당 회계연도·직후 12개월의 총액</strong>으로 산정하도록 합니다.
            금지가 아니라 <strong>합산</strong>이며, 합산 결과로 계약방식이 달라집니다.
          </li>
        </ul>
      </div>
    </div>

    <!-- 계약 정보 입력 -->
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-bold text-slate-900 mb-5 flex items-center gap-2">
        <span class="material-symbols-outlined text-red-600">edit</span>
        계약 정보 입력
      </h2>

      <div class="mb-5">
        <label class="block text-sm font-semibold text-slate-700 mb-2">계약 유형</label>
        <select id="contract-type" class="form-input w-full" onchange="onTypeChange()">
          <option value="">선택하세요 — 유형에 따라 적용 조문이 다릅니다</option>
          <option value="goods">물품 (시행령 제7조제2호 · 추정가격 합산)</option>
          <option value="service">용역 (시행령 제7조제2호 · 추정가격 합산)</option>
          <option value="construction_general">종합공사 (시행령 제77조)</option>
          <option value="construction_special">전문공사 (시행령 제77조)</option>
          <option value="construction_etc">그 밖의 공사 — 전기·소방·정보통신 (시행령 제77조)</option>
        </select>
      </div>

      <!-- 공사 트랙: §77 요건 -->
      <div id="construction-track" class="hidden">
        <div class="bg-slate-50 rounded-xl p-5 mb-4">
          <h3 class="text-sm font-bold text-slate-700 mb-1">제77조제1항 금지 요건</h3>
          <p class="text-xs text-slate-500 mb-4">두 요건을 <strong>모두</strong> 충족할 때 금지 대상입니다. 모르면 "모름"으로 두세요 — 추측해서 채우면 판정이 사실보다 앞서갑니다.</p>
          <div class="space-y-4" id="construction-factors"></div>
        </div>

        <div class="bg-emerald-50 rounded-xl p-5 mb-4 border border-emerald-100">
          <h3 class="text-sm font-bold text-emerald-900 mb-1">분리가 허용되는 사유 (제77조제1항 각 호)</h3>
          <p class="text-xs text-emerald-700 mb-3">해당하는 사유가 있으면 선택하세요. 법령상 분리발주가 요구되는 공사가 여기에 들어갑니다.</p>
          <select id="separation-ground" class="form-input w-full" onchange="evaluate()">
            <option value="">해당 없음 / 모름</option>
            <option value="D77-1-1">제1호 — 다른 법령에 따라 다른 업종의 공사와 분리 발주할 수 있도록 규정된 공사</option>
            <option value="D77-1-2">제2호 — 공구·구조물을 적정규모로 분할 시공하는 것이 효율적인 공사 (보고 의무)</option>
            <option value="D77-1-3-가">제3호 가목 — 설계서가 별도로 작성되는 공사</option>
            <option value="D77-1-3-나">제3호 나목 — 시공 목적물·시기·장소가 명확히 구분되는 공사</option>
          </select>
        </div>
      </div>

      <!-- 물품·용역 트랙: §7제2호 요건 -->
      <div id="goods-track" class="hidden">
        <div class="bg-slate-50 rounded-xl p-5 mb-4">
          <h3 class="text-sm font-bold text-slate-700 mb-1">제7조제2호 합산 요건</h3>
          <p class="text-xs text-slate-500 mb-4">합산 대상 기간은 <strong>12개월</strong>(직전 12개월 · 해당 회계연도 · 직후 12개월)입니다.</p>
          <div class="space-y-4" id="goods-factors"></div>
        </div>

        <div class="mb-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-3">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">이번 계약 추정가격 (만원)</label>
              <input type="number" id="current-amount" placeholder="예: 1800" min="0" class="form-input w-full" oninput="evaluate()">
            </div>
          </div>
          <div class="flex items-center justify-between mb-3">
            <label class="text-sm font-semibold text-slate-700">합산 대상 기간(12개월) 내 동일·유사 목적 계약</label>
            <button type="button" onclick="addPrevContract()" class="text-xs text-red-600 hover:text-red-800 font-medium flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">add</span>
              계약 추가
            </button>
          </div>
          <div id="prev-contracts">
            <div class="prev-contract-item flex gap-3 mb-3 items-center">
              <input type="text" placeholder="계약 목적 (예: 사무용품 구매)" class="form-input flex-1 text-sm">
              <input type="number" placeholder="금액(만원)" min="0" class="form-input w-28 text-sm prev-amount" oninput="evaluate()">
              <button type="button" onclick="removePrevContract(this)" class="text-slate-300 hover:text-red-500 hidden">
                <span class="material-symbols-outlined text-base">close</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 빈 상태 — 조문 reference + 감사 빈출 패턴 (Information Scent) -->
    <div id="empty-state-card" class="mb-4">
      <div class="card p-5 border-2 border-slate-100">
        <div class="flex items-center gap-2 mb-4">
          <span class="material-symbols-outlined text-editorial-navy">verified</span>
          <h3 class="text-sm font-bold text-slate-800">수의계약 한도 (지방계약법 시행령 제25조제1항제5호가·나목)</h3>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
          <div class="text-center p-3 rounded-lg bg-slate-50 border border-slate-100">
            <div class="text-[10px] text-slate-500 font-semibold tracking-wide mb-1">물품·용역</div>
            <div class="text-base font-bold text-slate-800">2,000<span class="text-xs font-medium">만원</span></div>
            <div class="text-[10px] text-slate-400 mt-1">나목</div>
          </div>
          <div class="text-center p-3 rounded-lg bg-slate-50 border border-slate-100">
            <div class="text-[10px] text-slate-500 font-semibold tracking-wide mb-1">종합공사</div>
            <div class="text-base font-bold text-slate-800">4<span class="text-xs font-medium">억원</span></div>
            <div class="text-[10px] text-slate-400 mt-1">가목</div>
          </div>
          <div class="text-center p-3 rounded-lg bg-slate-50 border border-slate-100">
            <div class="text-[10px] text-slate-500 font-semibold tracking-wide mb-1">전문공사</div>
            <div class="text-base font-bold text-slate-800">2<span class="text-xs font-medium">억원</span></div>
            <div class="text-[10px] text-slate-400 mt-1">가목</div>
          </div>
          <div class="text-center p-3 rounded-lg bg-slate-50 border border-slate-100">
            <div class="text-[10px] text-slate-500 font-semibold tracking-wide mb-1">그 밖의 공사</div>
            <div class="text-base font-bold text-slate-800">1.6<span class="text-xs font-medium">억원</span></div>
            <div class="text-[10px] text-slate-400 mt-1">가목</div>
          </div>
        </div>
        <p class="text-[11px] text-slate-500 mb-5 leading-relaxed">
          위 금액은 <strong>수의계약을 할 수 있는 범위</strong>이지 1인 견적 기준이 아닙니다.
          견적 요건은 별도 조문(제30조제1항)이며 <strong>2인 이상이 원칙</strong>, 추정가격 2,000만원 이하일 때 1인 견적이 예외로 허용됩니다.
        </p>

        <div class="mb-4">
          <p class="text-[10px] font-bold text-red-600 uppercase tracking-wider mb-2">⚠️ 감사에서 자주 지적되는 형태</p>
          <div class="space-y-2">
            <div class="flex items-start gap-2 p-2.5 rounded-lg bg-red-50/40 border border-red-100">
              <span class="text-[10px] font-bold text-red-700 bg-red-100 px-1.5 py-0.5 rounded flex-shrink-0 mt-0.5">물품</span>
              <p class="text-xs text-slate-700 leading-relaxed">동일 업체와 사무용품을 1,800만원씩 나눠 계약 → 제7조제2호에 따라 <strong>12개월 총액</strong>으로 추정가격을 산정하면 2,000만원을 넘어 1인 견적 대상이 아니게 됩니다.</p>
            </div>
            <div class="flex items-start gap-2 p-2.5 rounded-lg bg-red-50/40 border border-red-100">
              <span class="text-[10px] font-bold text-red-700 bg-red-100 px-1.5 py-0.5 rounded flex-shrink-0 mt-0.5">공사</span>
              <p class="text-xs text-slate-700 leading-relaxed">전체 사업내용이 확정된 청사 도장공사를 동·층별로 나눠 발주 → 제77조제1항의 시기적·공사량 분할에 해당할 수 있습니다.</p>
            </div>
            <div class="flex items-start gap-2 p-2.5 rounded-lg bg-emerald-50/40 border border-emerald-100">
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded flex-shrink-0 mt-0.5">적법</span>
              <p class="text-xs text-slate-700 leading-relaxed">다른 법령이 분리 발주를 규정한 공사는 제77조제1항제1호에 따라 <strong>분리가 허용</strong>됩니다. 나눴다는 사실만으로 위법이 되지 않습니다.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
          <button type="button" onclick="loadSampleScenario()"
                  class="flex-1 py-2.5 px-3 bg-violet-50 hover:bg-violet-100 border border-violet-200 rounded-lg text-sm font-medium text-violet-700 transition-colors inline-flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined" style="font-size:16px">auto_awesome</span>
            샘플 시나리오로 결과 미리보기
          </button>
          <%= link_to audit_cases_path(q: '분할계약'), class: "flex-1 py-2.5 px-3 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 transition-colors inline-flex items-center justify-center gap-1.5" do %>
            <span class="material-symbols-outlined" style="font-size:16px">gavel</span>
            분할계약 감사사례 검색
          <% end %>
        </div>
      </div>
    </div>

    <!-- 결과 -->
    <div id="result-card" class="hidden">
    </div>

    <%= render 'shared/ad_slot', position: 'tool-result' %>

    <!-- 법령 가이드 링크 -->
    <div class="mt-6 p-5 bg-blue-50 rounded-2xl border border-blue-100">
      <div class="flex items-start gap-3">
        <span class="material-symbols-outlined text-blue-600 mt-0.5">menu_book</span>
        <div>
          <p class="text-sm font-semibold text-blue-900 mb-1">관련 법령 가이드</p>
          <p class="text-xs text-blue-700 mb-2">분할계약 금지 원칙의 법적 근거와 감사사례를 확인하세요</p>
          <%= link_to topic_path("split-contract"), class: "inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800" do %>
            <span class="material-symbols-outlined text-xs">open_in_new</span>
            분할계약 금지 법령 가이드 보기
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# P9 Information Scent — 이 도구 다음 단계 %>
<%= render 'shared/tool_next_actions',
  tool_key: 'split-contract-checker',
  next_actions: [
    { type: 'topic', path: topic_path('split-contract'), label: '함께 보는 토픽',
      title: '분할계약 금지 사유', desc: '연간계약 회피·예산 분할의 위법 판단',
      icon: 'block', color: 'emerald' },
    { type: 'tool',  path: contract_method_path, label: '관련 도구',
      title: '계약방법 결정', desc: '금액·성격별 적정 계약방법 자동 판단',
      icon: 'rule', color: 'amber' },
    { type: 'guide', path: audit_frequent_issues_path, label: '단계별 가이드',
      title: '감사 단골 지적사항', desc: '분할계약·중복지급 등 자주 지적되는 사례',
      icon: 'menu_book', color: 'blue' }
  ]
%>

<script>
  // 판정은 서버(ContractDecision::SplitProcurementEvaluator)가 한다.
  // 이 화면은 입력을 모으고 결과를 그린다 — 조문 요건을 여기에 두면
  // 테스트도 뮤테이션도 걸 수 없고, 실제로 근거 없는 임계값이 그렇게 들어와 있었다.

  const CONSTRUCTION_FACTORS = [
    { key: 'single_project',   label: '동일 구조물공사 또는 단일공사인가?',
      hint: '행정안전부장관이 정하는 동일 구조물공사·단일공사에 해당하는지 (제77조제1항)' },
    { key: 'scope_fixed',      label: '설계서 등으로 전체 사업내용이 확정되었는가?',
      hint: '계획 단계에서 전체 범위가 정해진 공사인지 (제77조제1항)' },
    { key: 'avoidance_intent', label: '수의계약 한도나 경쟁을 회피하려는 분할인가?',
      hint: '분리 사유가 있어도 회피 목적이면 허용되지 않는다 (제77조제3항)' }
  ];

  const GOODS_FACTORS = [
    { key: 'same_purpose',  label: '동일하거나 유사한 조달 요구인가?',
      hint: '목적·규격·용도가 같거나 유사한 계약인지 (제7조제2호)' },
    { key: 'within_window', label: '합산 대상 기간(12개월 / 해당 회계연도) 안인가?',
      hint: '직전 12개월, 해당 회계연도, 직후 12개월 중 어느 기준을 쓰는지 확인 (제7조제2호 가·나목)' }
  ];

  const STATE_STYLE = {
    HIGH_SPLIT_RISK:               { label: '분할 위험 높음',        cls: 'red' },
    REVIEW_NEEDED:                 { label: '검토 필요',            cls: 'amber' },
    LEGITIMATE_SEPARATION_POSSIBLE:{ label: '적법한 분리 가능',      cls: 'emerald' },
    LOW_RISK:                      { label: '금지 요건 미해당',      cls: 'slate' },
    INSUFFICIENT_INFORMATION:      { label: '판단하기에 정보 부족',  cls: 'slate' }
  };

  function renderFactors(containerId, factors) {
    const box = document.getElementById(containerId);
    if (box.dataset.built === '1') return;
    box.innerHTML = factors.map(function (f) {
      return '<div>' +
        '<p class="text-sm font-medium text-slate-800">' + f.label + '</p>' +
        '<p class="text-xs text-slate-500 mb-2">' + f.hint + '</p>' +
        '<div class="flex gap-2" role="radiogroup">' +
          ['yes:예', 'no:아니오', 'unknown:모름'].map(function (opt) {
            const v = opt.split(':')[0], t = opt.split(':')[1];
            return '<label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">' +
              '<input type="radio" name="' + f.key + '" value="' + v + '"' +
              (v === 'unknown' ? ' checked' : '') + ' onchange="evaluate()" class="accent-red-600">' + t +
            '</label>';
          }).join('') +
        '</div></div>';
    }).join('');
    box.dataset.built = '1';
  }

  function factorValues(factors) {
    const out = {};
    factors.forEach(function (f) {
      const el = document.querySelector('input[name="' + f.key + '"]:checked');
      out[f.key] = el ? el.value : 'unknown';
    });
    return out;
  }

  function selectedType() { return document.getElementById('contract-type').value; }
  function isConstruction() { return selectedType().indexOf('construction') === 0; }

  function onTypeChange() {
    const t = selectedType();
    const c = document.getElementById('construction-track');
    const g = document.getElementById('goods-track');
    c.classList.toggle('hidden', !(t && isConstruction()));
    g.classList.toggle('hidden', !(t && !isConstruction()));
    if (t && isConstruction()) renderFactors('construction-factors', CONSTRUCTION_FACTORS);
    if (t && !isConstruction()) renderFactors('goods-factors', GOODS_FACTORS);
    evaluate();
  }

  function addPrevContract() {
    const container = document.getElementById('prev-contracts');
    const div = document.createElement('div');
    div.className = 'prev-contract-item flex gap-3 mb-3 items-center';
    div.innerHTML =
      '<input type="text" placeholder="계약 목적" class="form-input flex-1 text-sm">' +
      '<input type="number" placeholder="금액(만원)" min="0" class="form-input w-28 text-sm prev-amount" oninput="evaluate()">' +
      '<button type="button" onclick="removePrevContract(this)" class="text-slate-300 hover:text-red-500">' +
      '<span class="material-symbols-outlined text-base">close</span></button>';
    container.appendChild(div);
    const firstBtn = container.querySelector('.prev-contract-item button.hidden');
    if (firstBtn) firstBtn.classList.remove('hidden');
  }

  function removePrevContract(btn) {
    btn.closest('.prev-contract-item').remove();
    const items = document.querySelectorAll('.prev-contract-item');
    if (items.length === 1) {
      const b = items[0].querySelector('button');
      if (b) b.classList.add('hidden');
    }
    evaluate();
  }

  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function manwon(n) { return (n == null ? 0 : Math.round(n / 10000)).toLocaleString('ko-KR'); }

  let pending = null;

  function evaluate() {
    const type = selectedType();
    const resultCard = document.getElementById('result-card');
    const emptyCard = document.getElementById('empty-state-card');

    if (!type) {
      resultCard.classList.add('hidden');
      if (emptyCard) emptyCard.classList.remove('hidden');
      return;
    }

    const factors = isConstruction() ? factorValues(CONSTRUCTION_FACTORS) : factorValues(GOODS_FACTORS);
    const body = {
      contract_type: type,
      factors: factors,
      separation_ground: isConstruction() ? document.getElementById('separation-ground').value : null,
      current_amount: isConstruction() ? null : toWon(document.getElementById('current-amount').value),
      prior_amounts: isConstruction() ? [] :
        Array.prototype.map.call(document.querySelectorAll('.prev-amount'), function (el) { return toWon(el.value); })
             .filter(function (v) { return v > 0; })
    };

    clearTimeout(pending);
    pending = setTimeout(function () { postEvaluate(body); }, 150);
  }

  // 화면은 만원 단위로 받고 서버에는 원 단위로 보낸다.
  function toWon(v) {
    const n = parseFloat(v);
    return isNaN(n) ? 0 : Math.round(n * 10000);
  }

  async function postEvaluate(body) {
    try {
      const res = await fetch('<%= split_contract_evaluate_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]')?.content || ''
        },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      renderResult(data);
    } catch (e) {
      console.error(e);
    }
  }

  function block(title, items, render) {
    if (!items || !items.length) return '';
    return '<div class="mt-4"><h4 class="text-xs font-bold text-slate-500 mb-2">' + title + '</h4>' +
           '<ul class="list-disc pl-5 space-y-1">' +
           items.map(function (i) { return '<li class="text-sm text-slate-700 leading-relaxed">' + render(i) + '</li>'; }).join('') +
           '</ul></div>';
  }

  // 검토축 — 근거가 있는 축과 없는 축을 갈라서 보여준다.
  // 근거 없는 축을 "해당 없음"으로 접어 버리면 확인해야 할 것이 사라진다.
  function axesBlock(axes) {
    if (!axes || !axes.length) return '';
    const ANSWER = { YES: '예', NO: '아니오', UNKNOWN: '모름',
                     CLAIMED: '주장함', NOT_CLAIMED: '주장 안 함', REVIEW_REQUIRED: '검토 필요' };
    const rows = axes.map(function (a) {
      const basis = a.legal_basis
        ? '<a class="text-blue-700 underline" href="' + esc(a.legal_basis.url) + '" target="_blank" rel="noopener">' +
          esc(a.legal_basis.locator) + '</a>'
        : '<span class="text-amber-700 font-semibold">공식 근거 미확인</span>';
      const reason = a.review_reason
        ? '<div class="text-[11px] text-slate-500 mt-1">' + esc(a.review_reason) + '</div>' : '';
      return '<tr class="border-t border-slate-100">' +
        '<td class="py-2 pr-3 align-top text-xs text-slate-700">' + esc(a.label) + reason + '</td>' +
        '<td class="py-2 pr-3 align-top text-xs font-semibold whitespace-nowrap ' +
          (a.answer === 'REVIEW_REQUIRED' ? 'text-amber-700' : 'text-slate-800') + '">' +
          esc(ANSWER[a.answer] || a.answer) + '</td>' +
        '<td class="py-2 align-top text-xs whitespace-nowrap">' + basis + '</td></tr>';
    }).join('');
    return '<div class="mt-5"><h4 class="text-xs font-bold text-slate-500 mb-2">검토축 — 이 계약유형에 적용되는 근거</h4>' +
      '<div class="overflow-x-auto"><table class="w-full text-left"><thead><tr class="text-[10px] uppercase text-slate-400">' +
      '<th class="pb-1 pr-3">항목</th><th class="pb-1 pr-3">입력</th><th class="pb-1">근거 조문</th>' +
      '</tr></thead><tbody>' + rows + '</tbody></table></div></div>';
  }

  function renderResult(d) {
    const resultCard = document.getElementById('result-card');
    const emptyCard = document.getElementById('empty-state-card');
    resultCard.classList.remove('hidden');
    if (emptyCard) emptyCard.classList.add('hidden');

    const st = STATE_STYLE[d.state] || { label: d.state, cls: 'slate' };
    const tone = {
      red:     { border: 'border-red-300',     bg: 'bg-red-50',     chip: 'bg-red-600' },
      amber:   { border: 'border-amber-300',   bg: 'bg-amber-50',   chip: 'bg-amber-600' },
      emerald: { border: 'border-emerald-300', bg: 'bg-emerald-50', chip: 'bg-emerald-700' },
      slate:   { border: 'border-slate-300',   bg: 'bg-slate-50',   chip: 'bg-slate-600' }
    }[st.cls];

    let agg = '';
    if (d.aggregation) {
      const a = d.aggregation;
      agg =
        '<div class="grid grid-cols-3 gap-3 my-5">' +
          '<div class="bg-white rounded-xl p-3 text-center border border-slate-100">' +
            '<div class="text-xs text-slate-500 mb-1">이번 계약</div>' +
            '<div class="text-lg font-bold text-slate-800">' + manwon(a.current) + '만원</div></div>' +
          '<div class="bg-white rounded-xl p-3 text-center border border-slate-100">' +
            '<div class="text-xs text-slate-500 mb-1">' + a.window_months + '개월 내 합산</div>' +
            '<div class="text-lg font-bold text-slate-600">' + manwon(a.prior_total) + '만원</div></div>' +
          '<div class="bg-white rounded-xl p-3 text-center border border-slate-100">' +
            '<div class="text-xs text-slate-500 mb-1">추정가격 (제7조제2호)</div>' +
            '<div class="text-lg font-bold text-slate-900">' + manwon(a.total) + '만원</div>' +
            '<div class="text-xs text-slate-500">1인 견적 기준 ' + manwon(a.single_quote_threshold) + '만원 · ' + esc(a.threshold_locator) + '</div></div>' +
        '</div>';
    }

    resultCard.innerHTML =
      '<div class="card p-6 border-2 ' + tone.border + ' ' + tone.bg + '">' +
        '<span class="inline-block text-xs font-bold text-white px-3 py-1 rounded-full ' + tone.chip + '">' + esc(st.label) + '</span>' +
        '<p class="text-base font-bold text-slate-900 mt-3 leading-relaxed">' + esc(d.headline) + '</p>' +
        agg +
        block('아직 확인되지 않은 것', d.unresolved_factors, function (f) {
          return '<strong>' + esc(f.factor) + '</strong> — ' + esc(f.detail); }) +
        block('근거 조문', d.legal_basis, function (b) {
          return '<a class="text-blue-700 underline" href="' + esc(b.url) + '" target="_blank" rel="noopener">' +
                 esc(b.short || b.title) + ' ' + esc(b.locator) + '</a>' +
                 (b.quote ? '<span class="block text-xs text-slate-500 mt-1 pl-2 border-l-2 border-slate-300">' + esc(b.quote) + '</span>' : ''); }) +
        block('분리가 허용되는 사유 (제77조제1항 각 호)', d.lawful_separation_grounds, function (g) {
          return esc(g.label) + ' <span class="text-xs text-slate-500">(' + esc(g.source_locator) + ')</span>'; }) +
        block('함께 지켜야 할 의무', d.duties, function (x) {
          return '<strong>' + esc(x.source_locator) + '</strong> ' + esc(x.text); }) +
        block('다음에 할 일', d.next_actions, function (a) { return esc(a); }) +
        axesBlock(d.review_axes) +
        '<p class="mt-5 pt-4 border-t border-slate-200 text-xs text-slate-500 leading-relaxed">' +
          '이 결과는 <strong>적법·위법 확정이 아닙니다.</strong> 입력한 사실관계를 조문 요건에 대조한 것이며, ' +
          '실제 판단은 사업계획·설계서·예산편성 자료를 근거로 담당자가 해야 합니다.' +
        '</p>' +
        '<div class="mt-4"><a href="<%= contract_method_path %>" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold">' +
          '<span class="material-symbols-outlined" style="font-size:16px">gavel</span>' +
          '합산한 금액으로 계약방식 다시 확인하기</a></div>' +
      '</div>';
  }

  // 샘플: 물품 분할 (제7조제2호 합산으로 기준 초과가 되는 형태)
  function loadSampleScenario() {
    document.getElementById('contract-type').value = 'goods';
    onTypeChange();
    document.getElementById('current-amount').value = 1800;
    const firstRow = document.querySelector('.prev-contract-item');
    if (firstRow) {
      firstRow.querySelector('input[type="text"]').value = '사무용품 구매 (1차)';
      firstRow.querySelector('.prev-amount').value = 1800;
    }
    addPrevContract();
    const rows = document.querySelectorAll('.prev-contract-item');
    const second = rows[rows.length - 1];
    second.querySelector('input[type="text"]').value = '사무용품 구매 (2차)';
    second.querySelector('.prev-amount').value = 1500;
    document.querySelector('input[name="same_purpose"][value="yes"]').checked = true;
    document.querySelector('input[name="within_window"][value="yes"]').checked = true;
    evaluate();
    document.getElementById('result-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', onTypeChange);
</script>
