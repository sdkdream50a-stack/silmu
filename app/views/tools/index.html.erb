<%# 실무 도구 목록 페이지 %>

<!-- 페이지 헤더 -->
<section class="gradient-indigo text-white py-10 lg:py-12 relative overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-[300px] h-[300px] bg-white/5 rounded-full blur-[80px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[200px] h-[200px] bg-white/5 rounded-full blur-[60px]"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>
  <div class="container-wide relative">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 glass-panel rounded-2xl flex items-center justify-center shadow-lg shrink-0">
          <span class="material-symbols-outlined text-3xl text-white">construction</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold tracking-tight mb-1">실무 도구</h1>
          <p class="text-white/80 text-sm">복잡한 계산과 검토를 간편하게 — 전면 무료</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 도구 목록 -->
<section class="py-10 lg:py-12" data-controller="tools-filter">
  <div class="container-wide">

    <!-- 검색 + 뷰 토글 -->
    <div class="flex flex-col sm:flex-row gap-3 mb-5">
      <div class="relative flex-1">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
        <input type="text"
               data-tools-filter-target="searchInput"
               data-action="input->tools-filter#search"
               placeholder="도구 이름으로 검색 (예: 여비, 계약보증금)"
               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-editorial-navy-light">
      </div>
      <!-- 뷰 토글 -->
      <div class="flex rounded-xl overflow-hidden border border-slate-200 bg-slate-100 self-start sm:self-auto">
        <button type="button"
                data-tools-filter-target="gridBtn"
                data-action="click->tools-filter#showGrid"
                class="flex items-center gap-1.5 px-3 py-2.5 text-sm font-medium transition-colors bg-editorial-navy text-white"
                title="그리드 뷰">
          <span class="material-symbols-outlined text-base">grid_view</span>
          <span class="hidden sm:inline">그리드</span>
        </button>
        <button type="button"
                data-tools-filter-target="listBtn"
                data-action="click->tools-filter#showList"
                class="flex items-center gap-1.5 px-3 py-2.5 text-sm font-medium transition-colors bg-slate-100 text-slate-600"
                title="리스트 뷰">
          <span class="material-symbols-outlined text-base">view_list</span>
          <span class="hidden sm:inline">목록</span>
        </button>
      </div>
    </div>

    <!-- 업무 분야 탭 (계약/예산/인사/여비/기타) -->
    <div class="flex flex-wrap gap-2 mb-3">
      <% [
        { label: "전체", domain: "전체", icon: "apps" },
        { label: "계약", domain: "계약", icon: "gavel" },
        { label: "예산", domain: "예산", icon: "bar_chart" },
        { label: "인사·급여", domain: "인사", icon: "payments" },
        { label: "여비·출장", domain: "여비", icon: "directions_car" },
        { label: "기타", domain: "기타", icon: "more_horiz" },
      ].each_with_index do |item, i| %>
        <button type="button"
                data-tools-filter-target="domainTab"
                data-action="click->tools-filter#filterDomain"
                data-domain="<%= item[:domain] %>"
                class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors <%= i == 0 ? 'bg-editorial-navy text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
          <span class="material-symbols-outlined text-base"><%= item[:icon] %></span>
          <%= item[:label] %>
        </button>
      <% end %>
    </div>

    <!-- 유형 탭 (자동화/계산기/문서/체크리스트) -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      <% ["전체", "자동화 도구", "계산기", "문서 도구", "체크리스트"].each_with_index do |label, i| %>
        <button type="button"
                data-tools-filter-target="tab"
                data-action="click->tools-filter#filterCategory"
                data-cat="<%= label %>"
                class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors <%= i == 0 ? 'bg-editorial-navy text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
          <%= label %>
        </button>
      <% end %>
    </div>

    <!-- 결과 카운트 -->
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-slate-700">바로 사용 가능한 도구</h2>
      <span class="badge badge-indigo" data-tools-filter-target="countBadge"><%= tool_count %>개 도구</span>
    </div>

    <%
      # 도구 데이터 — ToolsHelper#tools_registry (silmu-search 도구 검색과 공용 소스)
      # unlisted 도구는 카드 목록에서 제외 (검색에만 노출)
      tools_data = tools_registry.reject { |t| t[:unlisted] }

      # S4 — 도구 ItemList 구조화데이터 (검색 풍부도·도구 색인 회복)
      tools_item_list = {
        "@context" => "https://schema.org",
        "@type" => "ItemList",
        "name" => "공무원 계약·예산·인사 실무 도구",
        "numberOfItems" => tools_data.size,
        "itemListElement" => tools_data.each_with_index.map do |tool, i|
          { "@type" => "ListItem", "position" => i + 1, "name" => tool[:title],
            "url" => "https://silmu.kr#{tool[:path]}" }
        end
      }
    %>
    <script type="application/ld+json"><%= raw tools_item_list.to_json %></script>

    <!-- 그리드 뷰 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
         id="tools-grid"
         data-tools-filter-target="gridContainer">
      <% tools_data.each do |tool| %>
        <%= link_to tool[:path],
              class: "group card card-interactive card-glow-#{tool[:color]} card-shine p-6 relative overflow-hidden border border-transparent hover:border-#{tool[:color]}-200",
              data: {
                "tools-filter-target": "card",
                category: tool[:category],
                domain:   tool[:domain],
                title:    tool[:title],
                desc:     tool[:desc]
              } do %>
          <% if tool[:badge] %>
            <span class="absolute top-4 right-4 badge <%= tool[:badge] == 'NEW' ? 'badge-amber' : 'badge-indigo' %>"><%= tool[:badge] %></span>
          <% end %>
          <div class="icon-container icon-container-lg bg-<%= tool[:color] %>-100 group-hover:bg-<%= tool[:color] %>-600 transition-all duration-300 mb-4 group-hover:shadow-lg group-hover:shadow-<%= tool[:color] %>-500/20">
            <span class="material-symbols-outlined text-3xl text-<%= tool[:color] %>-600 group-hover:text-white transition-colors"><%= tool[:icon] %></span>
          </div>
          <span class="text-xs font-semibold text-slate-400 mb-2 block"><%= tool[:category] %></span>
          <h3 class="text-base font-semibold text-slate-900 mb-2 group-hover:text-<%= tool[:color] %>-600 transition-colors"><%= tool[:title] %></h3>
          <p class="text-slate-600 text-sm leading-relaxed"><%= tool[:desc] %></p>
          <div class="mt-4 flex items-center text-<%= tool[:color] %>-600 text-sm font-semibold">
            바로 사용
            <span class="material-symbols-outlined text-lg ml-1 group-hover:translate-x-1.5 transition-transform">arrow_forward</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 리스트 뷰 -->
    <div class="hidden divide-y divide-slate-100 border border-slate-200 rounded-2xl overflow-hidden bg-white"
         data-tools-filter-target="listContainer">
      <% tools_data.each do |tool| %>
        <%= link_to tool[:path],
              class: "group flex items-center gap-4 px-5 py-3.5 hover:bg-slate-50 transition-colors",
              data: {
                "tools-filter-target": "card",
                category: tool[:category],
                domain:   tool[:domain],
                title:    tool[:title],
                desc:     tool[:desc]
              } do %>
          <div class="w-9 h-9 rounded-xl bg-<%= tool[:color] %>-100 group-hover:bg-<%= tool[:color] %>-600 flex items-center justify-center transition-colors shrink-0">
            <span class="material-symbols-outlined text-lg text-<%= tool[:color] %>-600 group-hover:text-white transition-colors"><%= tool[:icon] %></span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-slate-800 group-hover:text-<%= tool[:color] %>-700 transition-colors truncate"><%= tool[:title] %></span>
              <% if tool[:badge] %>
                <span class="badge <%= tool[:badge] == 'NEW' ? 'badge-amber' : 'badge-indigo' %> shrink-0"><%= tool[:badge] %></span>
              <% end %>
            </div>
            <p class="text-xs text-slate-400 truncate mt-0.5"><%= tool[:desc] %></p>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="hidden sm:inline text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md"><%= tool[:category] %></span>
            <span class="material-symbols-outlined text-slate-300 text-base group-hover:text-<%= tool[:color] %>-400 group-hover:translate-x-0.5 transition-all">chevron_right</span>
          </div>
        <% end %>
      <% end %>
    </div>

  </div>
</section>

<!-- 곧 추가될 도구 -->
<section class="py-12 bg-surface-50">
  <div class="container-wide">
    <div class="flex items-center gap-3 mb-6">
      <span class="material-symbols-outlined text-slate-300">hourglass_empty</span>
      <h2 class="text-lg font-bold text-slate-600">곧 추가될 도구</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% [
        { title: "급여명세서 생성기", icon: "description", category: "문서 도구" },
        { title: "복지포인트 잔액 안내", icon: "redeem", category: "안내" },
      ].each do |tool| %>
        <div class="flex items-center gap-3 px-4 py-3.5 bg-white rounded-xl border border-gray-100/80 hover:border-gray-200 hover:shadow-soft transition-all">
          <span class="w-9 h-9 bg-surface-100 rounded-lg flex items-center justify-center">
            <span class="material-symbols-outlined text-lg text-slate-300"><%= tool[:icon] %></span>
          </span>
          <div>
            <h4 class="text-sm font-semibold text-slate-700"><%= tool[:title] %></h4>
            <span class="text-xs text-slate-400"><%= tool[:category] %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-16 bg-white relative overflow-hidden">
  <div class="absolute top-0 left-1/3 w-[200px] h-[200px] bg-editorial-navy/[0.03] rounded-full blur-[60px]"></div>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
    <div class="icon-container icon-container-lg bg-gradient-to-br from-editorial-navy-bg to-editorial-navy-light mx-auto mb-6 shadow-sm">
      <span class="material-symbols-outlined text-3xl text-editorial-navy">lightbulb</span>
    </div>
    <h2 class="text-2xl font-bold text-slate-900 mb-4">필요한 도구가 없으신가요?</h2>
    <p class="text-slate-500 mb-8">원하시는 도구를 요청해주시면 검토 후 개발을 진행합니다.</p>
    <a href="mailto:hello@silmu.kr?subject=도구 요청" class="btn btn-point btn-md shadow-md hover:shadow-lg">
      <span class="material-symbols-outlined">mail</span>
      이메일로 요청하기
    </a>
  </div>
</section>
