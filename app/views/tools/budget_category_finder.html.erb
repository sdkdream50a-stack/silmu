<%# 예산 과목 분류 도우미 %>

<section class="section py-10">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 뒤로가기 -->
    <div class="mb-6">
      <%= link_to tools_path, class: "inline-flex items-center text-slate-600 hover:text-emerald-600 transition-colors font-medium" do %>
        <span class="material-symbols-outlined mr-1">arrow_back</span>
        도구 목록으로
      <% end %>
    </div>

    <!-- 헤더 -->
    <div class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="icon-container icon-container-lg gradient-emerald shadow-lg">
          <span class="material-symbols-outlined text-3xl text-white">category</span>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-slate-900">예산 과목 분류 도우미</h1>
          <p class="text-slate-500">지출 내용 입력 → 세출예산 과목(목·세목) 즉시 추천</p>
          <%= render 'shared/use_when_badge', tool: 'budget-category-finder' %>
        </div>
      </div>
      <%= render 'shared/jurisdiction_notice', tool_key: 'budget-category-finder' %>

      <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-5">
        <p class="text-emerald-800 text-sm leading-relaxed">
          <strong>사용 방법:</strong> 지출 내용 또는 키워드를 입력하거나 카테고리를 선택하면 적합한 세출예산 과목을 추천합니다.
          <strong>근거:</strong> 지방재정법 §41(예산의 과목 구분) + 행안부 「지방자치단체 예산편성 운영기준」 별표 11 · 「지방자치단체 세출예산 집행기준」 (매년 개정)
        </p>
        <p class="text-amber-800 text-xs leading-relaxed mt-2">
          지방자치단체 세출예산 과목입니다. <strong>학교회계는 시·도교육청 학교회계 예산편성 기본지침의 과목 체계</strong>를 따르므로 이 코드를 그대로 쓰지 마세요.
        </p>
      </div>
    </div>

    <!-- 검색 입력 -->
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-bold text-slate-900 mb-5 flex items-center gap-2">
        <span class="material-symbols-outlined text-emerald-600">search</span>
        지출 내용 검색
      </h2>
      <div class="relative mb-5">
        <input type="text" id="search-input" placeholder="예: 복사용지, 출장비, 강사비, 시설보수, 차량연료비..."
               class="form-input w-full pl-10 text-base" oninput="searchCategory()" autocomplete="off">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
      </div>

      <!-- 빠른 선택 태그 -->
      <div>
        <p class="text-xs font-semibold text-slate-500 mb-2 uppercase tracking-wide">자주 찾는 항목</p>
        <div class="flex flex-wrap gap-2">
          <% [
            "복사용지", "소모품", "출장비", "강사비", "시설보수",
            "차량유류비", "회의비", "교육훈련비", "청소용역", "수선비"
          ].each do |tag| %>
            <button type="button" onclick="quickSearch('<%= tag %>')"
                    class="px-3 py-1.5 text-xs font-medium bg-slate-100 hover:bg-emerald-100 hover:text-emerald-700 text-slate-600 rounded-full transition-colors">
              <%= tag %>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 카테고리별 탐색 -->
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-emerald-600">folder_open</span>
        분야별 탐색
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <button type="button" onclick="filterCategory('물건비')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">inventory_2</span>
          <span class="text-sm font-semibold text-slate-700">물건비</span>
          <p class="text-xs text-slate-500">소모품, 비품, 연료 등</p>
        </button>
        <button type="button" onclick="filterCategory('인건비')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">person</span>
          <span class="text-sm font-semibold text-slate-700">인건비</span>
          <p class="text-xs text-slate-500">보수, 수당, 일용인부 등</p>
        </button>
        <button type="button" onclick="filterCategory('경상이전')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">sync_alt</span>
          <span class="text-sm font-semibold text-slate-700">경상이전</span>
          <p class="text-xs text-slate-500">보조금, 민간이전 등</p>
        </button>
        <button type="button" onclick="filterCategory('시설비')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">construction</span>
          <span class="text-sm font-semibold text-slate-700">시설비</span>
          <p class="text-xs text-slate-500">공사, 시설장비 등</p>
        </button>
        <button type="button" onclick="filterCategory('업무추진비')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">work</span>
          <span class="text-sm font-semibold text-slate-700">업무추진비</span>
          <p class="text-xs text-slate-500">기관운영비, 시책추진비</p>
        </button>
        <button type="button" onclick="filterCategory('여비')" class="cat-btn p-3 bg-slate-50 hover:bg-emerald-50 rounded-xl border border-slate-200 hover:border-emerald-300 text-left transition-colors">
          <span class="material-symbols-outlined text-slate-500 text-lg mb-1 block">flight_takeoff</span>
          <span class="text-sm font-semibold text-slate-700">여비</span>
          <p class="text-xs text-slate-500">국내여비, 국외여비</p>
        </button>
      </div>
    </div>

    <!-- 검색 결과 -->
    <div id="search-results">
      <!-- 전체 목록 기본 표시 -->
    </div>
    <%= render 'shared/ad_slot', position: 'tool-result' %>
  </div>
</section>

<%# P9 Information Scent — 과목 분류 다음 단계 %>
<%= render 'shared/tool_next_actions',
  tool_key: 'budget-category-finder',
  next_actions: [
    { type: 'tool',  path: budget_execution_rate_path, label: '바로 계산',
      title: '예산 집행률 계산', desc: '과목별 집행률·잔액·권장률 비교',
      icon: 'bar_chart', color: 'emerald' },
    { type: 'tool',  path: budget_transfer_checker_path, label: '관련 도구',
      title: '이월·전용 판단기', desc: '과목 변경 가능 여부 즉시 확인',
      icon: 'swap_horiz', color: 'amber' },
    { type: 'tool',  path: subsidy_settlement_checker_path, label: '관련 도구',
      title: '보조금 정산 체크리스트', desc: '민간이전 과목 정산 필수 항목',
      icon: 'volunteer_activism', color: 'blue' }
  ]
%>

<script>
  // 2026-09-28 전 도구 기능 감사 P0 — 종전 코드 24개 중 21개가 별표 11 과 달랐다(110·120·130·240·700·800 등 존재하지 않거나 다른 그룹).
  // 정본: 「지방자치단체 예산편성 운영기준」 별표 11 «세출예산 성질별 분류»(law.go.kr flSeq=134501851, 2026-09-28 열람).
  // 코드는 편성목(3자리) 또는 통계목(3자리-2자리). 원문에서 위치를 확인한 것만 적는다.
  const BUDGET_CATEGORIES = [
    // 인건비
    { keywords: ["보수","월급","급여","봉급","인건비","임금"], category: "인건비", sub: "인건비", code: "101-01", note: "공무원 보수(기본급·수당·정액급식비 등) — 별표 11 101-01" },
    { keywords: ["수당","시간외","야간","휴일","초과근무","특수업무"], category: "인건비", sub: "직책급여·수당", code: "101-01", note: "법정 수당은 보수(101-01)에 포함 — 별표 11 101-01 «2. 수당»" },
    { keywords: ["일용","임시직","기간제","아르바이트","파트타임"], category: "인건비", sub: "기간제근로자등 보수", code: "101-04", note: "기간제 근로자 임금 — 별표 11 101-04. 사무보조 근로자는 계상 불가" },
    { keywords: ["강사","강의료","강사비","강사료","외부강사"], category: "물건비", sub: "사무관리비", code: "201-01", note: "교육 외래강사료는 사무관리비(201-01), 행사 지원 강사료는 행사운영비(201-03) — 별표 11" },
    { keywords: ["청소원","경비원","용역직","공무직"], category: "인건비", sub: "공무직등보수", code: "101-03", note: "상시 청소·경비 등 공무직(무기계약) 근로자 보수 — 별표 11 101-03" },

    // 물건비
    { keywords: ["복사지","복사용지","A4","프린터용지","인쇄용지"], category: "물건비", sub: "사무관리비", code: "201-01", note: "사무용 잡품·용지 — 별표 11 201-01" },
    { keywords: ["소모품","사무용품","볼펜","문구","스테이플러"], category: "물건비", sub: "사무관리비", code: "201-01", note: "사무용 소모품 — 별표 11 201-01" },
    { keywords: ["인쇄","출력","현수막","홍보물","유인물"], category: "물건비", sub: "사무관리비", code: "201-01", note: "인쇄물·현수막·홍보물 제작 — 별표 11 201-01" },
    { keywords: ["유류","연료","경유","휘발유","가스","LPG","CNG"], category: "물건비", sub: "사무관리비 > 연료대", code: "201-01", note: "냉·난방 연료대 등 — 별표 11 201-01. 공공요금(전기·가스·상하수도)은 201-02" },
    { keywords: ["전기","전력","전기요금","전기세","한전"], category: "물건비", sub: "공공운영비 > 공공요금및제세", code: "201-02", note: "전기료·가스료·상하수도료 — 별표 11 201-02" },
    { keywords: ["수도","상수도","하수도","수도세"], category: "물건비", sub: "공공운영비 > 공공요금및제세", code: "201-02", note: "상·하수도료 — 별표 11 201-02" },
    { keywords: ["가스","도시가스","LNG","난방비"], category: "물건비", sub: "공공운영비 > 공공요금및제세", code: "201-02", note: "가스료 — 별표 11 201-02" },
    { keywords: ["비품","가구","책상","의자","컴퓨터","PC","노트북","프린터"], category: "물건비", sub: "비품 및 집기류", code: "201-01 / 405-01", note: "재물조사 대상 아닌 소모성 물품은 201-01, 정수 물품·비정수 물품구입은 405-01 — 별표 11" },
    { keywords: ["의약품","약품","응급","의료용품"], category: "물건비", sub: "재료비", code: "206", note: "응급처치용 의약품·방역 약품 등 — 별표 11 206" },
    { keywords: ["식비","급식비","식대","점심","조식","석식","급식"], category: "물건비", sub: "보수 > 정액급식비", code: "101-01", note: "직원 급식은 정액급식비(101-01). 공무원 급식비 보전·지원 목적의 별도 편성은 불가 — 별표 11 201-01 주석" },
    { keywords: ["피복","유니폼","작업복","제복","점퍼"], category: "물건비", sub: "사무관리비 > 피복", code: "201-01", note: "피복·침구·개인장구 구입비 — 별표 11 201-01" },

    // 여비
    { keywords: ["출장","국내출장","국내여비","출장비","교통비","숙박비","일비","식비"], category: "여비", sub: "국내여비", code: "202-01", note: "국내여비 — 별표 11 202-01" },
    { keywords: ["해외출장","국외여비","국외출장","해외연수","외국"], category: "여비", sub: "국외여비", code: "202-03", note: "국외업무여비 — 별표 11 202-03" },

    // 업무추진비
    { keywords: ["기관운영","회의비","직원식비","격려금","행사","간담회"], category: "업무추진비", sub: "기관운영업무추진비", code: "203-01", note: "기관운영업무추진비 — 별표 11 203-01. 건당·월간 한도 준수" },
    { keywords: ["시책추진","행사비","홍보","캠페인","시민참여"], category: "업무추진비", sub: "시책추진업무추진비", code: "203-03", note: "시책추진업무추진비 — 별표 11 203-03" },
    { keywords: ["부서운영","팀운영","부서활동","회식"], category: "업무추진비", sub: "부서운영업무추진비", code: "203-04", note: "부서운영업무추진비 — 별표 11 203-04" },

    // 직무수행경비
    { keywords: ["교통카드","교통비","차량유지","주차비","통행료"], category: "직무수행경비", sub: "사무관리비 > 통행료·주차료", code: "201-01", note: "고속도로 통행료·주차료 등 — 별표 11 201-01. 출장 교통비는 여비(202-01)" },

    // 연구개발비
    { keywords: ["연구","용역","연구용역","학술","연구비","분석"], category: "연구개발비", sub: "연구용역비", code: "207-01", note: "연구용역비 — 별표 11 207-01" },

    // 교육훈련비
    { keywords: ["교육","훈련","직무교육","연수","세미나","워크숍","강좌"], category: "물건비", sub: "사무관리비", code: "201-01", note: "직원 교육 외래강사료 등은 사무관리비(201-01) — 별표 11. 민간 위탁교육은 307-12" },

    // 일반 용역
    { keywords: ["용역","위탁","청소용역","경비용역","시설관리","외주","대행"], category: "물건비", sub: "용역비", code: "201-01", note: "청사 시설관리 용역·장비 유지관리 — 별표 11 201-01. 특정 장비 개별 수리는 201-02" },

    // 시설비
    { keywords: ["공사","신축","증축","개축","보수","수선","리모델링","도로포장","배관","전기공사"], category: "시설비", sub: "시설비", code: "401-01", note: "시설비 — 별표 11 401-01. 설계·감리는 401-02·401-03" },
    { keywords: ["시설장비유지","장비유지","기계유지","시설보수유지"], category: "물건비", sub: "공공운영비 > 시설장비유지비", code: "201-02", note: "특정 시설장비 개별 수리·보수 — 별표 11 201-02(시설장비유지비). 신규 구입은 405-01" },

    // 경상이전
    { keywords: ["보조금","지방보조금","민간보조","국고보조","지원금","교부금"], category: "경상이전", sub: "민간이전", code: "307-02", note: "민간경상사업보조 — 별표 11 307-02" },
    { keywords: ["사회단체","비영리","단체지원","협회","복지관"], category: "경상이전", sub: "민간이전", code: "307", note: "민간이전(법정운영비 보조 307-03·민간행사 307-04 등) — 별표 11 307" },
    { keywords: ["노인","장애인","기초수급","복지급여","급여지급"], category: "경상이전", sub: "사회보장이전", code: "301-01 / 301-03", note: "사회보장적수혜금(국고보조 재원 301-01·지방 재원 301-03) — 별표 11" },

    // 자본지출
    { keywords: ["토지","건물매입","부동산취득","자산취득"], category: "자본지출", sub: "자산취득비", code: "405-01", note: "건물·공작물 등 자산 취득 — 별표 11 405-01" },
  ];

  // P2: 예산 과목 → silmu 도구 cross-link 매핑 (sub 정확 일치)
  const SUB_TO_TOOL = {
    '인건비':            { path: '/tools/salary-calculator',         label: '봉급 계산기로 계산' },
    '직책급여·수당':     { path: '/tools/allowance-calculator',      label: '수당 계산기로 계산' },
    '국내여비':          { path: '/tools/travel-calculator',         label: '여비 계산기로 계산' },
    '국외여비':          { path: '/tools/travel-calculator',         label: '여비 계산기로 계산' },
    '용역비':            { path: '/tools/quote-review',              label: '견적서 검토기로 확인' },
    '시설비':            { path: '/tools/cost-estimate',             label: '물량내역서·시방서 도구' },
    '민간이전':          { path: '/tools/subsidy-settlement-checker', label: '보조금 정산 체크리스트' }
  };

  let currentFilter = null;

  function searchCategory() {
    const query = document.getElementById('search-input').value.trim().toLowerCase();
    currentFilter = null;
    if (!query) { renderAll(); return; }
    renderResults(BUDGET_CATEGORIES.filter(item =>
      item.keywords.some(k => k.includes(query) || query.includes(k)) ||
      item.sub.toLowerCase().includes(query) ||
      item.category.toLowerCase().includes(query) ||
      item.note.toLowerCase().includes(query)
    ), query);
  }

  function quickSearch(term) {
    document.getElementById('search-input').value = term;
    searchCategory();
  }

  function filterCategory(cat) {
    currentFilter = cat;
    document.getElementById('search-input').value = '';
    renderResults(BUDGET_CATEGORIES.filter(item => item.category === cat || item.category.includes(cat)), null, cat);
  }

  // 검색 0건 시 유사 키워드 fallback — query 글자 1-2개 부분 매칭으로 후보 추출
  function findSimilarKeywords(query) {
    if (!query || query.length < 2) return [];
    const ngrams = [];
    for (let i = 0; i < query.length - 1; i++) ngrams.push(query.substring(i, i + 2));
    const scored = [];
    BUDGET_CATEGORIES.forEach(item => {
      let score = 0;
      const matchedKw = [];
      item.keywords.forEach(k => {
        const kl = k.toLowerCase();
        ngrams.forEach(g => { if (kl.includes(g)) { score += 1; if (!matchedKw.includes(k)) matchedKw.push(k); } });
      });
      if (score > 0) scored.push({ item, score, matchedKw });
    });
    return scored.sort((a, b) => b.score - a.score).slice(0, 5);
  }

  function renderResults(items, query, catLabel) {
    const container = document.getElementById('search-results');
    if (!items.length) {
      // P1: 유사 키워드 fallback + 인기 검색어 재노출 (Information Scent)
      const similar = query ? findSimilarKeywords(query) : [];
      const similarHtml = similar.length ? `
        <div class="mt-5 pt-5 border-t border-slate-100 text-left max-w-md mx-auto">
          <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">💡 이런 과목을 찾으시나요?</p>
          <div class="space-y-2">
            ${similar.map(({ item, matchedKw }) => `
              <button type="button" onclick="quickSearch('${matchedKw[0]}')" class="w-full text-left p-2.5 rounded-lg bg-emerald-50/50 hover:bg-emerald-50 border border-emerald-100 transition-colors">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">${item.category}</span>
                  <span class="text-xs font-bold text-slate-800">${item.sub}</span>
                </div>
                <p class="text-[11px] text-slate-500">매칭: ${matchedKw.slice(0, 3).join(', ')}</p>
              </button>
            `).join('')}
          </div>
        </div>` : '';

      const popularTags = ["복사용지", "출장비", "강사비", "시설보수", "회의비", "보조금"];
      container.innerHTML = `
        <div class="card p-8 text-center">
          <span class="material-symbols-outlined text-4xl text-slate-300 mb-3 block">search_off</span>
          <p class="text-slate-500 font-medium">${query ? `"${query}" 검색 결과가 없습니다` : '검색 결과가 없습니다'}</p>
          <p class="text-sm text-slate-400 mt-1">분야별 탐색을 이용하거나 아래 인기 검색어를 시도해 보세요</p>
          <div class="flex flex-wrap gap-2 justify-center mt-4">
            ${popularTags.map(t => `<button type="button" onclick="quickSearch('${t}')" class="px-3 py-1.5 text-xs font-medium bg-slate-100 hover:bg-emerald-100 hover:text-emerald-700 text-slate-600 rounded-full transition-colors">${t}</button>`).join('')}
          </div>
          ${similarHtml}
        </div>`;
      return;
    }

    const title = query ? `"${query}" 검색 결과 (${items.length}건)` : `${catLabel} 과목 목록 (${items.length}건)`;
    let html = `<div class="card p-5"><h2 class="text-sm font-bold text-slate-700 mb-4">${title}</h2><div class="space-y-3">`;

    items.forEach(item => {
      const tool = SUB_TO_TOOL[item.sub];
      const toolLink = tool ? `
        <a href="${tool.path}" class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-editorial-navy hover:underline">
          <span class="material-symbols-outlined" style="font-size:14px">build</span>
          ${tool.label}
          <span class="material-symbols-outlined" style="font-size:14px">arrow_forward</span>
        </a>` : '';
      html += `
        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50 transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">${item.category}</span>
                <span class="text-sm font-bold text-slate-900">${item.sub}</span>
                <span class="text-xs text-slate-400">과목 ${item.code}</span>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">${item.note}</p>
              <div class="mt-2 flex flex-wrap gap-1">
                ${item.keywords.slice(0, 5).map(k => `<span class="text-xs text-slate-400 bg-white border border-slate-200 px-2 py-0.5 rounded-full">${k}</span>`).join('')}
              </div>
              ${toolLink}
            </div>
          </div>
        </div>`;
    });

    html += `</div></div>`;
    container.innerHTML = html;
  }

  function renderAll() {
    const grouped = {};
    BUDGET_CATEGORIES.forEach(item => {
      if (!grouped[item.category]) grouped[item.category] = [];
      grouped[item.category].push(item);
    });

    const container = document.getElementById('search-results');
    let html = `<div class="space-y-4">`;
    Object.entries(grouped).forEach(([cat, items]) => {
      html += `
        <details class="card overflow-hidden">
          <summary class="p-4 cursor-pointer font-semibold text-slate-800 flex items-center justify-between hover:bg-slate-50">
            <span>${cat} <span class="text-xs font-normal text-slate-400">(${items.length}개 항목)</span></span>
            <span class="material-symbols-outlined text-slate-400 text-base">expand_more</span>
          </summary>
          <div class="px-4 pb-4 space-y-2">
            ${items.map(item => `
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-sm font-bold text-slate-800">${item.sub}</span>
                  <span class="text-xs text-slate-400">과목 ${item.code}</span>
                </div>
                <p class="text-xs text-slate-500">${item.note}</p>
              </div>`).join('')}
          </div>
        </details>`;
    });
    html += `</div>`;
    container.innerHTML = html;
  }

  document.addEventListener('DOMContentLoaded', renderAll);
</script>
