<%# P1-1 — 학교 행정실 상설 허브. 새 콘텐츠를 만들지 않고 기존 자산만 링크한다. %>
<section class="bg-editorial-navy text-white py-10 lg:py-14">
  <div class="container-editorial">
    <h1 class="text-2xl lg:text-3xl font-bold mb-3">학교 행정실 바로가기</h1>
    <p class="text-white/75 text-sm lg:text-base leading-relaxed max-w-2xl">
      계약·예산·급여·복무·물품에서 자주 찾는 자료를 한 곳에 모았습니다.
      학교회계 기준이 아닌 자료에는 그 사실을 함께 표시했습니다.
    </p>
  </div>
</section>

<div class="container-editorial py-10 space-y-10">
  <%# 축 내비 — 축이 여러 개면 스크롤만으로는 무엇이 어디 있는지 알 수 없다.
      앵커라서 JS 없이 동작하고, 축 이름이 곧 «여기서 다루는 업무» 의 목록이 된다. %>
  <nav aria-label="업무 축 바로가기" class="flex flex-wrap gap-2">
    <% @sections.each do |section| %>
      <a href="#<%= section[:id] %>"
         class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-editorial-ink hover:border-editorial-navy hover:text-editorial-navy transition-colors">
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true"><%= section[:icon] %></span>
        <%= section[:title] %>
      </a>
    <% end %>
  </nav>

  <% @sections.each do |section| %>
    <%# 계측 — 새 이벤트를 만들지 않고 기존 next_action_click 을 재사용한다(topic_slug=hub:school-office · slot=축:경로). %>
    <section id="<%= section[:id] %>" class="scroll-mt-20"
             data-controller="next-action" data-next-action-topic-slug-value="hub:school-office">
      <h2 class="heading-editorial-section flex items-center gap-2 mb-5">
        <span class="material-symbols-outlined text-editorial-navy" aria-hidden="true"><%= section[:icon] %></span>
        <%= section[:title] %>
      </h2>
      <% if section[:thin].present? %>
        <%# NEEDS 축 — 링크는 주되 «얇다» 를 숨기지 않는다. 있는 것처럼 보이는 것이 없는 것보다 나쁘다. %>
        <p class="mb-4 flex items-start gap-1.5 text-xs text-amber-800">
          <span class="material-symbols-outlined text-[14px] leading-4" aria-hidden="true">info</span>
          <span><%= section[:thin] %></span>
        </p>
      <% end %>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% section[:items].each do |item| %>
          <li>
            <%= link_to item[:path], class: "card-editorial card-editorial-interactive group block h-full",
                  data: { action: "click->next-action#track", "next-action-slot-param": "#{section[:id]}:#{item[:path]}" } do %>
              <span class="font-semibold text-editorial-ink group-hover:text-editorial-navy transition-colors">
                <%= item[:label] %>
              </span>
              <% if item[:note].present? %>
                <span class="mt-1.5 flex items-start gap-1 text-[11px] text-amber-800">
                  <span class="material-symbols-outlined text-[13px] leading-[15px]" aria-hidden="true">info</span>
                  <span><%= item[:note] %></span>
                </span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%# 아직 없는 업무를 «없다» 고 말한다.
      목록에 없다는 사실만으로는 «내가 못 찾은 것» 인지 «사이트에 없는 것» 인지 구별되지 않는다.
      찾다가 포기하게 두는 것보다 없다고 먼저 말하는 편이 행정실 담당자의 시간을 아낀다. %>
  <section>
    <h2 class="heading-editorial-section mb-3">여기에 아직 없는 업무</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      <strong>법인카드(클린카드)·시설 관리·급식·교육공무직 보수</strong>는 아직 절차 자료가 없습니다 —
      시도교육청 지침과 업무포털에서 확인하세요.
      법인카드는 <%= link_to "카드 관련 감사사례", "/audit-cases?sector=edu&q=카드", class: "underline" %>(재구성 사례)만 있습니다.
      <strong>결산</strong>은 <%= link_to "결산 절차", "/topics/budget-settlement", class: "underline" %>가 있지만
      지방자치단체 기준이라 학교회계 결산과 다릅니다.
    </p>
  </section>

  <%# 하단 고정 문구 — 판단 주체와 개인정보를 같이 세운다. %>
  <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 space-y-2">
    <p class="text-sm text-slate-700 leading-relaxed">
      이 페이지는 참고용 정리입니다. 학교회계·복무의 최종 판단은
      <strong>시도교육청 규칙·지침 원문과 담당자 확인</strong>으로 합니다.
    </p>
    <p class="text-sm text-amber-900 font-semibold flex items-start gap-1.5">
      <span class="material-symbols-outlined text-[16px] leading-[18px]" aria-hidden="true">privacy_tip</span>
      <span>이름·주민등록번호·급여·학생 정보를 입력하지 마세요.</span>
    </p>
  </div>
</div>
