<%= turbo_frame_tag "search-results" do %>
  <div class="max-w-4xl mx-auto px-4 mt-6" data-search-log-id="<%= @search_log&.id %>">
    <% if @query.present? %>

      <%# 결과 없음 %>
      <% no_results = @topics.blank? && @audit_cases.blank? && @guides.blank? && @templates.blank? && @tools.blank? %>
      <% if no_results %>
        <div class="bg-white rounded-2xl border border-slate-200 p-10 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-editorial-navy-bg flex items-center justify-center">
            <span class="material-symbols-outlined text-editorial-navy text-4xl">search_off</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">"<%= @query %>" 검색 결과가 없습니다</h3>
          <p class="text-slate-500 text-sm mb-6">다른 키워드로 검색하거나 아래 추천 키워드를 선택해보세요</p>
          <div class="flex flex-wrap gap-2 justify-center mb-6">
            <% ["수의계약", "적격심사", "입찰", "검수", "예산", "청렴서약서"].each do |kw| %>
              <button onclick="document.querySelector('[name=q]').value='<%= kw %>'; document.querySelector('[name=q]').closest('form').requestSubmit();"
                      class="px-4 py-2 bg-slate-50 hover:bg-editorial-navy-bg hover:text-editorial-navy-dark border border-slate-200 hover:border-editorial-navy-light text-slate-700 rounded-full text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-editorial-navy focus-visible:ring-offset-2">
                <%= kw %>
              </button>
            <% end %>
          </div>
          <%# P1.6 §41 — 막다른 길을 만들지 않는다. 다른 표현·둘러보기·질문 남기기 세 갈래를 준다. %>
          <div class="pt-5 border-t border-slate-100 text-left max-w-md mx-auto">
            <p class="text-xs font-semibold text-slate-500 mb-2">다른 표현으로 찾아보기</p>
            <p class="text-xs text-slate-500 leading-relaxed mb-4">
              업무에서 쓰는 말 대신 <strong class="text-slate-700">법령 용어</strong>로 바꾸면 찾아지는 경우가 많습니다.
              예: <span class="text-slate-700">연가 돈 → 연가보상비</span> · <span class="text-slate-700">출장 차비 → 여비</span> ·
              <span class="text-slate-700">업체 하나 견적 → 1인견적</span>
            </p>
            <div class="flex flex-wrap gap-4 justify-center text-xs">
              <%= link_to topics_path, class: "text-editorial-navy hover:text-editorial-navy-dark font-medium flex items-center gap-1", data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined text-sm">menu_book</span>법령 가이드 둘러보기
              <% end %>
              <%= link_to audit_cases_path, class: "text-editorial-navy hover:text-editorial-navy-dark font-medium flex items-center gap-1", data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined text-sm">policy</span>감사사례 둘러보기
              <% end %>
              <%= link_to feedback_path, class: "text-editorial-navy hover:text-editorial-navy-dark font-medium flex items-center gap-1", data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined text-sm">contact_support</span>이 업무를 요청하기
              <% end %>
            </div>
          </div>
        </div>

      <% else %>

        <%# ── ① 바로 답 (P1.6 §21) ──
             기존 FAQ 원문만 쓴다. 매칭 FAQ 가 없으면 카드를 아예 그리지 않는다 —
             빈 박스나 지어낸 요약은 거짓 신뢰가 된다. %>
        <% if @answer.present? %>
          <% answer_topic = @answer[:topic] %>
          <% answer_authority = AuthorityPresenter.new(answer_topic) %>
          <section class="mb-6 bg-white border-2 border-editorial-navy-light rounded-2xl p-5" aria-labelledby="direct-answer-heading">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-editorial-navy text-lg" aria-hidden="true">lightbulb</span>
              <h3 id="direct-answer-heading" class="text-sm font-bold text-editorial-navy">바로 답</h3>
              <span class="text-[11px] text-slate-400">실무.kr 검증 콘텐츠 인용</span>
            </div>

            <p class="text-sm font-bold text-slate-900 mb-2 leading-snug"><%= @answer[:question] %></p>
            <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line"><%= @answer[:answer] %></p>

            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-3">
              <%= render "shared/verification_badge", record: answer_topic, variant: "compact" %>
              <%# 적용 대상은 presenter 경유 · HIGH confidence 일 때만 나온다(§27·§32). 모델 직접 접근 금지. %>
              <% if answer_authority.show_agency_scope? && answer_authority.agency_labels.present? %>
                <span class="text-[11px] text-slate-500">적용 대상: <%= answer_authority.agency_labels.join(" · ") %></span>
              <% end %>
              <%= link_to topic_path(answer_topic.slug),
                    class: "ml-auto inline-flex items-center gap-1 text-xs font-bold text-editorial-navy hover:text-editorial-navy-dark",
                    data: { turbo_frame: "_top", search_result: "answer", search_rank: 1 } do %>
                자세히 보기 <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
              <% end %>
            </div>
          </section>
        <% end %>

        <%# ── 실무 도구 결과 ── %>
        <% if @tools.present? %>
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-emerald-500 text-lg">construction</span>
              <h3 class="text-sm font-bold text-slate-600">실무 도구 (<%= @tools.size %>)</h3>
            </div>
            <div class="space-y-2">
              <% @tools.each_with_index do |tool, i| %>
                <%= link_to tool[:path],
                      class: "flex items-start gap-4 bg-white border border-slate-200 hover:border-emerald-300 hover:shadow-sm rounded-xl p-4 transition-all group",
                      data: { turbo_frame: "_top", search_result: "tool", search_rank: i + 1 } do %>
                  <div class="w-9 h-9 bg-emerald-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-emerald-500 text-lg"><%= tool[:icon] %></span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-800 group-hover:text-emerald-700 truncate"><%= tool[:title] %></div>
                    <div class="text-xs text-slate-500 mt-0.5 line-clamp-1"><%= tool[:desc] %></div>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-emerald-400 text-base flex-shrink-0 mt-1">chevron_right</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── 법령 가이드 결과 ── %>
        <% if @topics.present? %>
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-indigo-500 text-lg">menu_book</span>
              <h3 class="text-sm font-bold text-slate-600">법령 가이드 (<%= @topics.size %>)</h3>
            </div>
            <div class="space-y-2">
              <% @topics.each_with_index do |topic, i| %>
                <%= link_to topic_path(topic.slug),
                      class: "flex items-start gap-4 bg-white border border-slate-200 hover:border-indigo-300 hover:shadow-sm rounded-xl p-4 transition-all group",
                      data: { turbo_frame: "_top", search_result: "topic", search_rank: i + 1 } do %>
                  <div class="w-9 h-9 bg-indigo-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-indigo-500 text-lg">gavel</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-800 group-hover:text-indigo-700 truncate"><%= topic.name %></div>
                    <div class="text-xs text-slate-500 mt-0.5 line-clamp-1"><%= topic.summary %></div>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-indigo-400 text-base flex-shrink-0 mt-1">chevron_right</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── 감사사례 결과 ── %>
        <% if @audit_cases.present? %>
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-orange-500 text-lg">policy</span>
              <h3 class="text-sm font-bold text-slate-600">감사사례 (<%= @audit_cases.size %>)</h3>
            </div>
            <div class="space-y-2">
              <% @audit_cases.each_with_index do |ac, i| %>
                <% severity_color = ac.severity == "중대" ? "red" : ac.severity == "보통" ? "orange" : "amber" %>
                <%= link_to audit_case_path(ac.slug),
                      class: "flex items-start gap-4 bg-white border border-slate-200 hover:border-orange-300 hover:shadow-sm rounded-xl p-4 transition-all group",
                      data: { turbo_frame: "_top", search_result: "audit_case", search_rank: i + 1 } do %>
                  <div class="w-9 h-9 bg-orange-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-orange-500 text-lg">warning</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-800 group-hover:text-orange-700 truncate"><%= ac.title %></div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-xs bg-orange-50 text-orange-600 px-2 py-0.5 rounded-full"><%= ac.category %></span>
                      <span class="text-xs text-slate-400"><%= ac.severity %></span>
                    </div>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-orange-400 text-base flex-shrink-0 mt-1">chevron_right</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── 실무 가이드 결과 ── %>
        <% if @guides.present? %>
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-emerald-500 text-lg">auto_stories</span>
              <h3 class="text-sm font-bold text-slate-600">실무 가이드 (<%= @guides.size %>)</h3>
            </div>
            <div class="space-y-2">
              <% @guides.each_with_index do |guide, i| %>
                <%= link_to guide_path(guide),
                      class: "flex items-start gap-4 bg-white border border-slate-200 hover:border-emerald-300 hover:shadow-sm rounded-xl p-4 transition-all group",
                      data: { turbo_frame: "_top", search_result: "guide", search_rank: i + 1 } do %>
                  <div class="w-9 h-9 bg-emerald-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-emerald-500 text-lg">auto_stories</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-800 group-hover:text-emerald-700 truncate"><%= guide.title %></div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <% sector_label = { "common" => "공통", "local_gov" => "지자체", "edu" => "교육행정" }[guide.sector] || guide.sector %>
                      <span class="text-xs bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full"><%= sector_label %></span>
                    </div>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-emerald-400 text-base flex-shrink-0 mt-1">chevron_right</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── 서식 템플릿 결과 ── %>
        <% if @templates.present? %>
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-teal-500 text-lg">description</span>
              <h3 class="text-sm font-bold text-slate-600">서식 템플릿 (<%= @templates.size %>)</h3>
            </div>
            <div class="space-y-2">
              <% @templates.each_with_index do |tmpl, i| %>
                <%= link_to templates_path,
                      class: "flex items-start gap-4 bg-white border border-slate-200 hover:border-teal-300 hover:shadow-sm rounded-xl p-4 transition-all group",
                      data: { turbo_frame: "_top", search_result: "template", search_rank: i + 1 } do %>
                  <div class="w-9 h-9 bg-teal-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-teal-500 text-lg">draft</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-800 group-hover:text-teal-700 truncate"><%= tmpl[:title] %></div>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-xs bg-teal-50 text-teal-600 px-2 py-0.5 rounded-full"><%= tmpl[:category] %></span>
                      <span class="text-xs text-slate-400"><%= tmpl[:formats].join(" · ") %></span>
                    </div>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-teal-400 text-base flex-shrink-0 mt-1">chevron_right</span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ── 전체 결과 링크 ── %>
        <div class="border-t border-slate-100 pt-4 flex flex-wrap gap-3">
          <% if @topics.present? %>
            <%= link_to topics_path, class: "text-xs text-indigo-600 hover:text-indigo-800 flex items-center gap-1", data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined text-sm">menu_book</span>
              법령 가이드 전체 보기
            <% end %>
          <% end %>
          <% if @audit_cases.present? %>
            <%= link_to audit_cases_path, class: "text-xs text-orange-600 hover:text-orange-800 flex items-center gap-1", data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined text-sm">policy</span>
              감사사례 전체 보기
            <% end %>
          <% end %>
          <% if @guides.present? %>
            <%= link_to guides_path, class: "text-xs text-emerald-600 hover:text-emerald-800 flex items-center gap-1", data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined text-sm">auto_stories</span>
              실무 가이드 전체 보기
            <% end %>
          <% end %>
          <% if @templates.present? %>
            <%= link_to templates_path, class: "text-xs text-teal-600 hover:text-teal-800 flex items-center gap-1", data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined text-sm">description</span>
              서식 전체 보기
            <% end %>
          <% end %>
        </div>

      <% end %>
    <% end %>
  </div>
<% end %>
