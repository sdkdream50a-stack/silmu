<%# 네비게이션 v2 — 드롭다운 포함 (5개 메뉴) %>
<% _colored_hero_pages = %w[home#index guides#index audit_cases#index topics#index] %>
<% _has_colored_hero = _colored_hero_pages.include?("#{controller_name}##{action_name}") %>

<nav class="<%= _has_colored_hero ? 'bg-white/95 border-b border-gray-100/60' : 'bg-gray-50 border-b border-gray-200' %> sticky top-0 z-50 transition-all duration-300"
     id="main-nav"
     aria-label="주 메뉴"
     data-controller="dropdown-nav"
     data-action="keydown.esc->dropdown-nav#handleKeydown">

  <div class="container-wide">
    <div class="flex justify-between h-16 lg:h-[4.5rem]">

      <!-- 로고 -->
      <div class="flex items-center">
        <%= link_to root_path, class: "group flex items-center gap-3 transition-all duration-200 hover:scale-[1.02]" do %>
          <div class="w-9 h-9 flex items-center justify-center drop-shadow-md group-hover:drop-shadow-lg transition-all">
            <svg width="36" height="36" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="실무.kr 로고" role="img">
              <defs>
                <linearGradient id="logo_grad_header" gradientUnits="userSpaceOnUse" x1="20" y1="20" x2="180" y2="180">
                  <stop stop-color="#137fec"/>
                  <stop offset="1" stop-color="#0ea5e9"/>
                </linearGradient>
              </defs>
              <path d="M100 20C60 20 40 45 40 45V140C40 165 70 180 100 180C130 180 160 165 160 140V45C160 45 140 20 100 20Z" fill="url(#logo_grad_header)"/>
              <path d="M85 70H115" stroke="white" stroke-linecap="round" stroke-opacity="0.9" stroke-width="8"/>
              <path d="M70 100H130" stroke="white" stroke-linecap="round" stroke-opacity="0.9" stroke-width="8"/>
              <path d="M85 130H115" stroke="white" stroke-linecap="round" stroke-opacity="0.9" stroke-width="8"/>
              <circle cx="100" cy="50" fill="white" fill-opacity="0.9" r="6"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-slate-900 tracking-tight">실무.kr</span>
        <% end %>
      </div>

      <!-- 데스크탑 메뉴 — P1.6: 콘텐츠 종류가 아니라 업무 중심 -->
      <div class="hidden lg:flex items-center gap-1">

        <%# --- 업무찾기 드롭다운 (법령가이드·실무가이드·감사사례를 업무 아래로 재배치) --- %>
        <div class="relative"
             data-action="mouseenter->dropdown-nav#hoverOpen mouseleave->dropdown-nav#hoverClose"
             data-dropdown-key="tasks">
          <button type="button"
                  class="<%= nav_class(:task_find) %> flex items-center gap-0.5"
                  data-action="click->dropdown-nav#toggle"
                  data-dropdown-key="tasks"
                  aria-haspopup="true">
            업무찾기
            <span class="material-symbols-outlined text-base transition-transform duration-200"
                  data-dropdown-nav-target="chevron"
                  data-dropdown-key="tasks"
                  aria-hidden="true">expand_more</span>
          </button>

          <div class="hidden absolute left-0 top-full pt-1 z-50 w-[min(380px,calc(100vw-2rem))]"
               data-dropdown-nav-target="panel"
               data-dropdown-key="tasks"
               data-action="mouseenter->dropdown-nav#panelEnter mouseleave->dropdown-nav#hoverClose"
               aria-hidden="true">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-4">
              <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 px-1">업무별로 찾기</p>
              <div class="grid grid-cols-2 gap-1">
                <% task_entries.each do |entry| %>
                  <%= link_to send(*entry[:path_helper]),
                        class: "group flex items-center gap-2.5 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors" do %>
                    <div class="w-8 h-8 rounded-lg <%= entry[:icon_class] %> flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-sm" aria-hidden="true"><%= entry[:icon] %></span>
                    </div>
                    <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 leading-tight"><%= entry[:label] %></span>
                  <% end %>
                <% end %>
              </div>
              <%# 기존 콘텐츠 종류 진입점은 삭제하지 않고 2차 표면으로 유지한다(§14·§51) %>
              <div class="mt-3 pt-3 border-t border-slate-100 grid grid-cols-3 gap-1">
                <%= link_to topics_path, class: "text-center px-2 py-2 rounded-lg hover:bg-slate-50 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors" do %>
                  법령가이드
                <% end %>
                <%= link_to guides_path, class: "text-center px-2 py-2 rounded-lg hover:bg-slate-50 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors" do %>
                  실무가이드
                <% end %>
                <%= link_to audit_cases_path, class: "text-center px-2 py-2 rounded-lg hover:bg-slate-50 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors" do %>
                  감사사례
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <%# --- 실무도구 드롭다운 --- %>
        <div class="relative"
             data-action="mouseenter->dropdown-nav#hoverOpen mouseleave->dropdown-nav#hoverClose"
             data-dropdown-key="tools">
          <button type="button"
                  class="<%= nav_class(:tools) %> flex items-center gap-0.5"
                  data-action="click->dropdown-nav#toggle"
                  data-dropdown-key="tools"
                  aria-haspopup="true">
            실무도구
            <span class="material-symbols-outlined text-base transition-transform duration-200"
                  data-dropdown-nav-target="chevron"
                  data-dropdown-key="tools"
                  aria-hidden="true">expand_more</span>
          </button>

          <div class="hidden absolute left-0 top-full pt-1 z-50 w-[min(320px,calc(100vw-2rem))]"
               data-dropdown-nav-target="panel"
               data-dropdown-key="tools"
               data-action="mouseenter->dropdown-nav#panelEnter mouseleave->dropdown-nav#hoverClose"
               aria-hidden="true">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-4">
              <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 px-1">인기 도구</p>
              <div class="grid grid-cols-2 gap-1">
                <% [
                  { icon: "gavel",          title: "계약방식 결정기",  path: :contract_method_path,      color: "emerald" },
                  { icon: "calculate",      title: "추정가격 계산기",  path: :estimated_price_path,       color: "indigo" },
                  { icon: "directions_car", title: "여비 계산기",      path: :travel_calculator_path,     color: "rose" },
                  { icon: "shield",         title: "계약보증금 계산기", path: :contract_guarantee_path,   color: "blue" },
                  { icon: "calendar_month", title: "법정기간 계산기",  path: :legal_period_path,          color: "amber" },
                ].each do |t| %>
                  <%= link_to send(t[:path]),
                        class: "group flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors" do %>
                    <div class="w-7 h-7 rounded-lg bg-<%= t[:color] %>-100 group-hover:bg-<%= t[:color] %>-200 flex items-center justify-center shrink-0 transition-colors">
                      <span class="material-symbols-outlined text-sm text-<%= t[:color] %>-600" aria-hidden="true"><%= t[:icon] %></span>
                    </div>
                    <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 leading-tight"><%= t[:title] %></span>
                  <% end %>
                <% end %>
              </div>
              <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-2">
                <%= link_to guide_resources_path, class: "flex-1 flex items-center gap-1.5 px-3 py-2 rounded-xl hover:bg-slate-50 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors" do %>
                  <span class="material-symbols-outlined text-sm text-slate-500" aria-hidden="true">folder_open</span>자료실
                <% end %>
                <%= link_to templates_path, class: "flex-1 flex items-center gap-1.5 px-3 py-2 rounded-xl hover:bg-slate-50 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors" do %>
                  <span class="material-symbols-outlined text-sm text-teal-500" aria-hidden="true">description</span>서식
                <% end %>
              </div>
              <div class="pt-2 border-t border-slate-100 mt-1">
                <%= link_to tools_path, class: "flex items-center justify-center gap-1 text-xs font-semibold text-editorial-navy hover:text-editorial-navy-dark transition-colors" do %>
                  전체 <%= tool_count %>개 도구 보기 <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <%# --- 신규자 (§26 — 기존 완전정복 시리즈·온보딩 재사용) --- %>
        <%= link_to onboarding_path, class: "#{nav_class(:newcomer)} flex items-center gap-1.5" do %>
          신규자
        <% end %>

        <%# --- 업무달력 아이콘 --- %>
        <%= link_to task_calendar_path,
              class: "#{nav_class(:task_calendar)} flex items-center gap-1.5 px-2.5 py-2 rounded-xl bg-editorial-navy-bg hover:bg-[#DCE6F3] text-editorial-navy-dark border border-editorial-navy-light/40 transition-colors",
              title: "업무달력" do %>
          <span class="material-symbols-outlined text-xl" aria-hidden="true">calendar_month</span>
          <span class="text-sm font-semibold hidden xl:inline">달력</span>
        <% end %>

        <%# --- 더보기 드롭다운 --- %>
        <div class="relative"
             data-action="mouseenter->dropdown-nav#hoverOpen mouseleave->dropdown-nav#hoverClose"
             data-dropdown-key="more">
          <button type="button"
                  class="nav-link py-2 flex items-center gap-0.5"
                  data-action="click->dropdown-nav#toggle"
                  data-dropdown-key="more"
                  aria-haspopup="true">
            더보기
            <span class="material-symbols-outlined text-base transition-transform duration-200"
                  data-dropdown-nav-target="chevron"
                  data-dropdown-key="more"
                  aria-hidden="true">expand_more</span>
          </button>

          <div class="hidden absolute right-0 top-full pt-1 z-50 w-52"
               data-dropdown-nav-target="panel"
               data-dropdown-key="more"
               data-action="mouseenter->dropdown-nav#panelEnter mouseleave->dropdown-nav#hoverClose"
               aria-hidden="true">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-2">
              <% [
                { icon: "psychology",     title: "AI 어시스턴트",  path: :ai_assistant_path,     badge: "AI" },
                { icon: "feedback",       title: "의견보내기",      path: :feedback_path,         badge: nil },
              ].each do |item| %>
                <%= link_to send(item[:path]),
                      class: "group flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors" do %>
                  <span class="material-symbols-outlined text-lg text-slate-500 group-hover:text-slate-700" aria-hidden="true"><%= item[:icon] %></span>
                  <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 flex-1"><%= item[:title] %></span>
                  <% if item[:badge] %>
                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700"><%= item[:badge] %></span>
                  <% end %>
                <% end %>
              <% end %>
              <div class="mt-1 pt-1 border-t border-slate-100 px-3 pb-1">
                <a href="https://exam.silmu.kr" target="_blank" rel="noopener"
                   class="group flex items-center gap-3 py-2.5 hover:text-slate-900 transition-colors">
                  <span class="material-symbols-outlined text-lg text-slate-500 group-hover:text-slate-700" aria-hidden="true">school</span>
                  <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 flex-1">시험 대비</span>
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-editorial-navy-bg text-editorial-navy">NEW</span>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 우측: 인증 + 모바일 버튼 -->
      <div class="flex items-center gap-3">
        <!-- 데스크탑 인증 -->
        <div class="hidden lg:flex items-center gap-3">
          <% if user_signed_in? %>
            <%= link_to mypage_path, class: "flex items-center gap-1.5 text-slate-600 hover:text-slate-900 font-medium transition-colors text-sm" do %>
              <span class="material-symbols-outlined text-xl" aria-hidden="true">account_circle</span>마이페이지
            <% end %>
            <%= button_to "로그아웃", destroy_user_session_path, method: :delete, form: { data: { turbo: false } }, class: "btn btn-ghost btn-sm" %>
          <% else %>
            <%= link_to "로그인", new_user_session_path, class: "text-sm text-slate-600 hover:text-slate-900 font-medium transition-colors" %>
            <%= link_to "무료 가입", new_user_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
        <!-- 모바일 햄버거 -->
        <button type="button"
                class="lg:hidden p-2.5 text-slate-600 hover:text-slate-900 hover:bg-gray-100 rounded-xl transition-colors"
                data-action="click->dropdown-nav#toggle"
                data-dropdown-key="mobile"
                id="mobile-menu-btn"
                aria-label="메뉴 열기">
          <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
        </button>
      </div>

    </div>
  </div>

  <!-- 모바일 메뉴 패널 -->
  <div class="lg:hidden hidden"
       data-dropdown-nav-target="panel"
       data-dropdown-key="mobile">
    <div class="px-4 py-3 space-y-0.5 bg-white border-t border-gray-100">
      <% mobile_base = "flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-colors text-sm" %>
      <% mobile_normal = "#{mobile_base} text-slate-700 hover:bg-gray-50" %>
      <% mobile_active  = "#{mobile_base} text-editorial-navy bg-editorial-navy-bg font-semibold" %>

      <%# 업무찾기 아코디언 (P1.6 — 업무 중심) %>
      <div>
        <button type="button"
                class="<%= (request.path.start_with?('/topics') || request.path.start_with?('/audit-cases')) ? mobile_active : mobile_normal %> w-full justify-between"
                data-action="click->dropdown-nav#toggle"
                data-dropdown-key="mobile-tasks">
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">work</span>업무찾기
          </span>
          <span class="material-symbols-outlined text-base transition-transform duration-200"
                data-dropdown-nav-target="chevron"
                data-dropdown-key="mobile-tasks"
                aria-hidden="true">expand_more</span>
        </button>
        <div class="hidden pl-4 pb-1"
             data-dropdown-nav-target="panel"
             data-dropdown-key="mobile-tasks">
          <div class="grid grid-cols-2 gap-1 pt-1">
            <% task_entries.each do |entry| %>
              <%= link_to entry[:label], send(*entry[:path_helper]),
                    class: "flex items-center gap-2 px-3 py-2 text-sm text-slate-600 hover:text-editorial-navy hover:bg-editorial-navy-bg rounded-lg transition-colors" %>
            <% end %>
          </div>
          <%# 기존 진입점 보존(§14) %>
          <div class="flex gap-2 pt-1">
            <%= link_to "법령가이드 →", topics_path, class: "px-3 py-2 text-xs text-editorial-navy font-semibold" %>
            <%= link_to "실무가이드 →", guides_path, class: "px-3 py-2 text-xs text-editorial-navy font-semibold" %>
            <%= link_to "감사사례 →", audit_cases_path, class: "px-3 py-2 text-xs text-editorial-navy font-semibold" %>
          </div>
        </div>
      </div>

      <%# 실무도구 아코디언 %>
      <div>
        <button type="button"
                class="<%= (request.path.start_with?('/tools') && !request.path.start_with?('/tools/task-calendar')) ? mobile_active : mobile_normal %> w-full justify-between"
                data-action="click->dropdown-nav#toggle"
                data-dropdown-key="mobile-tools">
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg" aria-hidden="true">construction</span>실무도구
          </span>
          <span class="material-symbols-outlined text-base transition-transform duration-200"
                data-dropdown-nav-target="chevron"
                data-dropdown-key="mobile-tools"
                aria-hidden="true">expand_more</span>
        </button>
        <div class="hidden pl-4 pb-1"
             data-dropdown-nav-target="panel"
             data-dropdown-key="mobile-tools">
          <div class="space-y-0.5 pt-1">
            <% [
              { title: "계약방식 결정기",  path: :contract_method_path },
              { title: "추정가격 계산기",  path: :estimated_price_path },
              { title: "여비 계산기",      path: :travel_calculator_path },
              { title: "계약보증금 계산기", path: :contract_guarantee_path },
              { title: "법정기간 계산기",  path: :legal_period_path },
            ].each do |t| %>
              <%= link_to t[:title], send(t[:path]),
                    class: "block px-3 py-2 text-sm text-slate-600 hover:text-editorial-navy hover:bg-editorial-navy-bg rounded-lg transition-colors" %>
            <% end %>
            <%= link_to "자료실", guide_resources_path, class: "block px-3 py-2 text-sm text-slate-600 hover:text-editorial-navy hover:bg-editorial-navy-bg rounded-lg transition-colors" %>
            <%= link_to "서식", templates_path, class: "block px-3 py-2 text-sm text-slate-600 hover:text-editorial-navy hover:bg-editorial-navy-bg rounded-lg transition-colors" %>
            <%= link_to "전체 #{tool_count}개 도구 →", tools_path, class: "block px-3 py-2 text-xs text-editorial-navy font-semibold" %>
          </div>
        </div>
      </div>

      <%# 신규자 %>
      <%= link_to onboarding_path, class: (request.path == "/start" ? mobile_active : mobile_normal) do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">school</span>신규자
      <% end %>

      <%# 업무달력 강조 %>
      <%= link_to task_calendar_path,
            class: "#{mobile_base} text-editorial-navy-dark bg-editorial-navy-bg border border-editorial-navy-light/40 hover:bg-[#DCE6F3] font-semibold" do %>
        <span class="material-symbols-outlined text-lg text-editorial-navy" aria-hidden="true">calendar_month</span>
        업무달력
        <span class="ml-auto text-xs px-1.5 py-0.5 bg-editorial-navy text-white rounded-md font-bold">이달</span>
      <% end %>

      <%# 구분선 %>
      <div class="h-px bg-gray-200 my-1"></div>
      <%= link_to ai_assistant_path, class: mobile_normal do %>
        <span class="material-symbols-outlined text-lg" aria-hidden="true">psychology</span>AI 어시스턴트
      <% end %>
      <a href="https://exam.silmu.kr" target="_blank" rel="noopener" class="<%= mobile_normal %>">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">school</span>시험 대비
      </a>

      <div class="h-px bg-gray-200 my-1"></div>

      <% if user_signed_in? %>
        <%= link_to mypage_path, class: mobile_normal do %>
          <span class="material-symbols-outlined text-lg" aria-hidden="true">account_circle</span>마이페이지
        <% end %>
        <%= button_to "로그아웃", destroy_user_session_path, method: :delete,
              form: { data: { turbo: false } },
              class: "w-full text-left px-4 py-3 text-slate-700 hover:bg-gray-50 rounded-xl font-medium transition-colors text-sm" %>
      <% else %>
        <%= link_to "로그인", new_user_session_path, class: mobile_normal %>
        <%= link_to "무료 가입", new_user_registration_path,
              class: "block px-4 py-3 bg-editorial-navy text-white text-center rounded-xl font-semibold hover:bg-editorial-navy-dark transition-colors text-sm" %>
      <% end %>
    </div>
  </div>
</nav>
